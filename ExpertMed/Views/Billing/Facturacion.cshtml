@{
    ViewData["Title"] = "Facturación";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
}

<!-- Inputs hidden para configuración -->
<input type="hidden" id="hasInsurance" value="@ViewBag.HasInsurance.ToString().ToLower()" />
<input type="hidden" id="insuranceCompanyId" value="@ViewBag.InsuranceCompanyId" />
<input type="hidden" id="AppointmentPatientId" value="@ViewBag.AppointmentPatientId" />
<input type="hidden" id="AppointmentId" value="@ViewBag.AppointmentId" />

<!-- Estilos complementarios para Velzon -->
<style>
    /* Mejoras sutiles manteniendo Velzon */
    .card-facturacion {
        transition: all 0.3s ease;
        border: 1px solid rgba(0,0,0,0.08);
    }

        .card-facturacion:hover {
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            transform: translateY(-2px);
        }

    .section-title {
        font-weight: 600;
        color: #495057;
        border-bottom: 2px solid #405189;
        padding-bottom: 0.5rem;
        margin-bottom: 1.5rem;
    }

    .table-facturacion tbody tr {
        transition: all 0.2s ease;
    }

        .table-facturacion tbody tr:hover {
            background-color: #f8f9fa;
            transform: scale(1.01);
        }

    .resumen-total {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-radius: 8px;
        padding: 1.25rem;
        border-left: 4px solid #405189;
    }

    .badge-metodo-pago {
        font-size: 0.85rem;
        padding: 0.5rem 1rem;
    }

    .input-with-icon-label i {
        color: #405189;
        margin-right: 0.5rem;
    }
</style>

<div class="row">
    <div class="col-12">
        <!-- Breadcrumb de Velzon -->
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0">Generación de Factura</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="javascript: void(0);">Facturación</a></li>
                    <li class="breadcrumb-item active">Nueva Factura</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-12">
        <form asp-action="Billing" asp-controller="Billing" method="post" enctype="multipart/form-data" id="billingForm">
            <!-- Hidden inputs - CRÍTICOS PARA EL CONTROLADOR -->
            <input type="hidden" name="CitaId" value="@ViewBag.AppointmentId" />
            <input type="hidden" name="AppointmentPatientId" value="@ViewBag.AppointmentPatientId" />
            <input type="hidden" id="insuranceCompanyIdHidden" name="InsuranceCompanyId" value="@ViewBag.InsuranceCompanyId" />

            <!-- CAMPOS OCULTOS PARA CRÉDITO - Estos son los que espera el controlador -->
            <input type="hidden" id="esCredito" name="EsCredito" value="false" />
            <input type="hidden" id="fechaVencimientoCredito" name="FechaVencimientoCredito" value="" />
            <input type="hidden" id="montoCredito" name="MontoCredito" value="" />
            <input type="hidden" id="medioPagoCredito" name="MedioPagoCredito" value="" />

            <!-- SECCIÓN 1: Datos de Facturación -->
            <div class="card card-facturacion">
                <div class="card-header align-items-center d-flex">
                    <h4 class="card-title mb-0 flex-grow-1">
                        <i class="ri-user-line me-2"></i>Datos de Facturación
                    </h4>
                    <div class="flex-shrink-0">
                        <span class="badge badge-soft-primary">Paso 1</span>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Botones de acción -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <button type="button" class="btn btn-primary w-100" id="btnCargarDatosPaciente">
                                <i class="ri-user-add-line me-2"></i>Cargar Datos del Paciente
                            </button>
                        </div>
                        <div class="col-md-6">
                            <button type="button" class="btn btn-soft-secondary w-100"
                                    data-bs-toggle="collapse" data-bs-target="#facturacion-extra"
                                    id="btnOtrosDatos">
                                <i class="ri-edit-box-line me-2"></i>Ingresar Otros Datos
                            </button>
                        </div>
                    </div>

                    <!-- Formulario colapsable -->
                    <div class="collapse" id="facturacion-extra">
                        <div class="border border-dashed rounded p-3">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label input-with-icon-label">
                                        <i class="ri-user-line"></i>Nombre completo <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" class="form-control" name="BillingDetailsNames"
                                           id="billingNames" placeholder="Nombre completo del cliente" required>
                                    <div class="invalid-feedback">El nombre es requerido</div>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label input-with-icon-label">
                                        <i class="ri-file-list-line"></i>Tipo de Documento <span class="text-danger">*</span>
                                    </label>
                                    <select class="form-select" name="BillingDetailsDocumentType"
                                            id="billingDocType" required>
                                        <option value="05" selected>Cédula</option>
                                        <option value="04">RUC</option>
                                        <option value="06">Pasaporte</option>
                                        <option value="07">Consumidor Final</option>
                                    </select>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label input-with-icon-label">
                                        <i class="ri-bank-card-line"></i>Identificación <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" class="form-control" name="BillingDetailsCiNumber"
                                           id="billingCiNumber" placeholder="Número de identificación" required>
                                    <div class="invalid-feedback" id="ciNumberError">Identificación inválida</div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label input-with-icon-label">
                                        <i class="ri-mail-line"></i>Correo Electrónico <span class="text-danger">*</span>
                                    </label>
                                    <input type="email" class="form-control" name="BillingDetailsEmail"
                                           id="billingEmail" placeholder="correo@ejemplo.com" required>
                                    <small class="text-muted">Requerido para envío de comprobante electrónico</small>
                                    <div class="invalid-feedback">Email inválido</div>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label input-with-icon-label">
                                        <i class="ri-phone-line"></i>Teléfono
                                    </label>
                                    <input type="tel" class="form-control" name="BillingDetailsPhone"
                                           id="billingPhone" placeholder="0999999999" maxlength="10">
                                    <div class="invalid-feedback">Teléfono inválido (10 dígitos)</div>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label input-with-icon-label">
                                        <i class="ri-map-pin-line"></i>Dirección
                                    </label>
                                    <input type="text" class="form-control" name="BillingDetailsAddress"
                                           id="billingAddress" placeholder="Dirección completa">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECCIÓN 2: Detalle de Servicios -->
            <div class="card card-facturacion">
                <div class="card-header align-items-center d-flex">
                    <h4 class="card-title mb-0 flex-grow-1">
                        <i class="ri-shopping-cart-line me-2"></i>Detalle de Servicios
                    </h4>
                    <div class="flex-shrink-0">
                        <span class="badge badge-soft-primary">Paso 2</span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered table-nowrap align-middle table-facturacion">
                            <thead class="table-light">
                                <tr>
                                    <th>Descripción</th>
                                    <th style="width: 10%;">Cantidad</th>
                                    <th class="no-insurance" style="width: 12%;">Precio Unit.</th>
                                    <th class="col-insurance d-none" style="width: 12%;">Precio Base</th>
                                    <th class="col-insurance d-none" style="width: 12%;">Cubre Seguro</th>
                                    <th class="col-insurance d-none" style="width: 12%;">Copago</th>
                                    <th style="width: 10%;">Desc. %</th>
                                    <th style="width: 12%;">Total</th>
                                    <th style="width: 8%;">Acción</th>
                                </tr>
                            </thead>
                            <tbody id="invoice-items-body"></tbody>
                        </table>
                    </div>
                    <button type="button" class="btn btn-success" id="btnAgregarItem">
                        <i class="ri-add-line align-bottom me-1"></i>Agregar Ítem
                    </button>
                </div>
            </div>

            <!-- SECCIÓN 3: Tipo de Venta -->
            <div class="card card-facturacion">
                <div class="card-header align-items-center d-flex">
                    <h4 class="card-title mb-0 flex-grow-1">
                        <i class="ri-money-dollar-circle-line me-2"></i>Tipo de Venta
                    </h4>
                    <div class="flex-shrink-0">
                        <span class="badge badge-soft-primary">Paso 3</span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">
                                Modalidad de Pago <span class="text-danger">*</span>
                            </label>
                            <select class="form-select" id="tipoVenta" name="TipoVenta" required>
                                <option value="contado" selected>Pago al Contado</option>
                                <option value="credito">Factura a Crédito</option>
                            </select>
                        </div>

                        <!-- Campos para crédito -->
                        <div class="col-md-8" id="campos-credito" style="display: none;">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">Plazo (días) <span class="text-danger">*</span></label>
                                    <input type="number" class="form-control" id="creditoDias"
                                           min="1" max="360" placeholder="Ej: 30">
                                    <small class="text-muted">Días para vencimiento</small>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Fecha Vencimiento</label>
                                    <input type="date" class="form-control bg-light" id="creditoFechaVencimientoDisplay"
                                           readonly>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Monto Total a Crédito</label>
                                    <input type="text" class="form-control bg-warning-subtle fw-bold"
                                           id="creditoMontoTotalDisplay" readonly>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECCIÓN 4: Métodos de Pago -->
            <div class="card card-facturacion" id="seccion-metodos-pago">
                <div class="card-header align-items-center d-flex">
                    <h4 class="card-title mb-0 flex-grow-1">
                        <i class="ri-wallet-line me-2"></i>Métodos de Pago
                    </h4>
                    <div class="flex-shrink-0">
                        <span class="badge badge-soft-primary">Paso 4</span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="alert alert-info border-0 mb-3">
                        <i class="ri-information-line me-2"></i>
                        Puede agregar múltiples métodos de pago. La suma debe coincidir con el total.
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered table-nowrap align-middle table-facturacion">
                            <thead class="table-light">
                                <tr>
                                    <th>Método de Pago</th>
                                    <th style="width: 20%;">Monto</th>
                                    <th>Comprobante</th>
                                    <th>Notas</th>
                                    <th style="width: 8%;">Acción</th>
                                </tr>
                            </thead>
                            <tbody id="payment-methods-body"></tbody>
                        </table>
                    </div>
                    <button type="button" class="btn btn-primary" id="btnAgregarMetodoPago">
                        <i class="ri-add-line align-bottom me-1"></i>Agregar Método de Pago
                    </button>
                </div>
            </div>

            <!-- SECCIÓN 5: Resumen -->
            <div class="card card-facturacion">
                <div class="card-header bg-soft-success">
                    <h4 class="card-title mb-0">
                        <i class="ri-calculator-line me-2"></i>Resumen de Totales
                    </h4>
                </div>
                <div class="card-body">
                    <!-- Resumen SIN seguro -->
                    <div id="resumen-sin-seguro" style="display: none;">
                        <div class="resumen-total">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0 text-muted">TOTAL A PAGAR:</h5>
                                <h3 class="mb-0 text-success">
                                    $<input type="text" class="border-0 bg-transparent text-end fw-bold fs-4 text-success"
                                            style="width: 150px;"
                                            name="TotalFactura" id="totalFacturaSinSeguro" readonly required>
                                </h3>
                            </div>
                        </div>
                    </div>

                    <!-- Resumen CON seguro -->
                    <div id="resumen-con-seguro" style="display: none;">
                        <div class="table-responsive">
                            <table class="table table-borderless mb-0">
                                <tbody>
                                    <tr>
                                        <td class="fw-semibold">Precio Total Clínica:</td>
                                        <td class="text-end">
                                            $<input type="text" class="border-0 bg-transparent text-end"
                                                    style="width: 100px;" id="totalPrecioBase" readonly>
                                        </td>
                                    </tr>
                                    <tr class="table-success">
                                        <td class="fw-bold">PACIENTE PAGA AHORA:</td>
                                        <td class="text-end">
                                            <h4 class="mb-0 text-success">
                                                $<input type="text" class="border-0 bg-transparent text-end fw-bold"
                                                        style="width: 120px; color: inherit;"
                                                        name="TotalFactura" id="totalFacturaConSeguro" readonly required>
                                            </h4>
                                        </td>
                                    </tr>
                                    <tr class="table-warning">
                                        <td class="fw-semibold">Copago Pendiente (Aseguradora):</td>
                                        <td class="text-end">
                                            $<input type="text" class="border-0 bg-transparent text-end"
                                                    style="width: 100px;" id="totalCopago" readonly>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Pendiente -->
                    <div class="alert alert-warning border-0 mt-3" id="alerta-pendiente">
                        <div class="d-flex justify-content-between align-items-center">
                            <strong>Pendiente por cubrir con métodos de pago:</strong>
                            <span class="badge bg-warning fs-5">$<span id="total-pendiente">0.00</span></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Botón final -->
            <div class="text-end mb-4">
                <button type="submit" class="btn btn-success btn-lg">
                    <i class="ri-save-line align-bottom me-1"></i>
                    Generar Factura y Registrar Pago
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Configuración de URLs para JavaScript
        window.BillingConfig = {
            urlBuscarProcedimientos: '@Url.Action("BuscarProcedimientos", "Tarifario")',
            urlGetPatientDetails: '@Url.Action("GetPatientDetails", "Patient")'
        };
    </script>
    <script src="~/assets/js/facturacion-sri.js"></script>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <script>
            Swal.fire({
                title: '¡Éxito!',
                text: '@successMessage',
                icon: 'success',
                confirmButtonText: 'OK',
                timer: 3000
            });
        </script>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <script>
            Swal.fire({
                title: 'Error',
                text: '@errorMessage',
                icon: 'error',
                confirmButtonText: 'OK'
            });
        </script>
    }
}
