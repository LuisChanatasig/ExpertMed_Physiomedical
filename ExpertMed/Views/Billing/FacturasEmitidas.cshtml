@model List<FacturaEmitidaDTO>

@{
    ViewData["Title"] = "Facturas Emitidas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border">
            <div class="card-header bg-light d-flex align-items-center justify-content-between">
                <h4 class="card-title mb-0">
                    <i class="mdi mdi-receipt-text-outline me-2"></i> Facturas Emitidas
                </h4>
                <small class="text-muted">Mostrando registros locales y electrónicos</small>
            </div>

            <div class="card-body">
                <div class="d-flex flex-wrap align-items-end gap-2 gap-md-3 mb-3">
                    <div class="d-flex flex-wrap align-items-end gap-2">
                        <div>
                            <label for="fDesde" class="form-label mb-1"><i class="mdi mdi-calendar-range"></i> Desde</label>
                            <input id="fDesde" type="date" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                        <div>
                            <label for="fHasta" class="form-label mb-1"><i class="mdi mdi-calendar-range"></i> Hasta</label>
                            <input id="fHasta" type="date" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>

                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-preset="hoy">Hoy</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-preset="7d">7 días</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-preset="mes">Mes</button>
                    </div>

                    <div class="ms-auto d-flex flex-wrap align-items-center gap-2">
                        <div class="input-group input-group-sm" style="max-width: 250px;">
                            <span class="input-group-text"><i class="mdi mdi-magnify"></i></span>
                            <input id="dtSearch" type="search" class="form-control" placeholder="Buscar...">
                        </div>

                        <button id="btnExportExcel" class="btn btn-sm btn-success">
                            <i class="mdi mdi-file-excel-outline"></i> Excel
                        </button>
                        <button id="btnAplicar" class="btn btn-sm btn-primary">
                            <i class="mdi mdi-filter-outline"></i> Aplicar
                        </button>
                        <button id="btnLimpiar" class="btn btn-sm btn-light">
                            <i class="mdi mdi-refresh"></i>
                        </button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table id="facturas-table" class="table table-hover table-bordered align-middle table-striped w-100">
                        <thead class="table-light text-nowrap">
                            <tr>
                                <th>N° Factura</th>
                                <th>Fecha</th>
                                <th>Paciente</th>
                                <th>Médico</th>
                                <th>Aseguradora</th>
                                <th class="text-end">Subtotal</th>
                                <th class="text-end">T. Aseguradora</th>
                                <th class="text-end">Copago</th>
                                <th>Pago</th>
                                <th class="text-center">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null)
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.Secuencial</td>
                                        <td data-order="@item.Fecha.ToString("yyyy-MM-dd")">@item.Fecha.ToString("dd/MM/yyyy")</td>
                                        <td>@item.Paciente</td>
                                        <td>@item.Medico</td>
                                        <td>@item.Aseguradora</td>
                                        <td class="text-end" data-raw="@item.Subtotal">@item.Subtotal.ToString("N2")</td>
                                        <td class="text-end" data-raw="@item.TotalAseguradora">@item.TotalAseguradora.ToString("N2")</td>
                                        <td class="text-end" data-raw="@item.TotalCopago">@item.TotalCopago.ToString("N2")</td>
                                        <td><span class="badge bg-primary text-uppercase">@item.MetodoPago</span></td>
                                        <td class="text-center">
                                            @if (item.Origen == "LOCAL" && item.FacturaId > 0)
                                            {
                                                <a href="@Url.Action("NotaVentaConTablaDinamica", "Billing", new { facturaId = item.FacturaId })" class="btn btn-sm btn-soft-primary">
                                                    <i class="mdi mdi-printer"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <small class="text-muted">@item.Origen</small>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <th colspan="5" class="text-end">Totales:</th>
                                <th class="text-end" id="ft-subtotal">$0.00</th>
                                <th class="text-end" id="ft-aseguradora">$0.00</th>
                                <th class="text-end" id="ft-copago">$0.00</th>
                                <th colspan="2"></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div id="loading-overlay" class="position-absolute top-0 start-0 w-100 h-100 d-none" style="background: rgba(255,255,255,0.7); z-index: 10;">
                    <div class="d-flex align-items-center justify-content-center h-100">
                        <div class="spinner-border text-primary"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css">
    
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>

    <script>
        window.FacturasConfig = {
        urls: {
        filtrar: '@Url.Action("Filtrar", "Facturas")',
        exportar: '@Url.Action("ExportarFacturasExcel", "Billing")',
        imprimir: '@Url.Action("NotaVentaConTablaDinamica", "Billing")'
        },
        token: '@Html.AntiForgeryToken()'
        };
    </script>
    <script src="~/assets/js/pages/facturas-emitidas.js"></script>
}