@* Modal de Pagos *@
<div class="modal fade" id="modalPago" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header p-3 text-white" style="background: linear-gradient(135deg, #2A5C66 0%, #44808d 100%);">
                <h5 class="modal-title text-white d-flex align-items-center">
                    <i class="ri-shield-check-line me-2 fs-20"></i>
                    <span>Emisión de Comprobante Electrónico</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-4">
                <div class="row g-4">
                    <div class="col-md-7">
                        <div class="d-flex align-items-center mb-3">
                            <div class="flex-shrink-0 avatar-xs">
                                <span class="avatar-title bg-info-subtle text-info rounded-circle"><i class="ri-user-settings-line"></i></span>
                            </div>
                            <h6 class="mb-0 ms-2 text-uppercase fw-bold text-muted fs-12">Datos del Receptor</h6>
                        </div>

                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label text-muted fs-11 fw-semibold mb-1">Razón Social / Nombres</label>
                                <input type="text" id="pagoNombres" class="form-control form-control-sm border-light-subtle shadow-none">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted fs-11 fw-semibold mb-1">Identificación</label>
                                <input type="text" id="pagoIdentificacion" class="form-control form-control-sm shadow-none">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted fs-11 fw-semibold mb-1">Tipo Identificación</label>
                                <select id="pagoTipoDoc" class="form-select form-select-sm shadow-none">
                                    <option value="05">Cédula</option>
                                    <option value="04">RUC</option>
                                    <option value="06">Pasaporte</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label text-muted fs-11 fw-semibold mb-1">Correo Electrónico (Para envío XML/PDF)</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text"><i class="ri-mail-send-line"></i></span>
                                    <input type="email" id="pagoEmail" class="form-control shadow-none" placeholder="ejemplo@correo.com">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-5">
                        <div class="card bg-light border-0 rounded-3 overflow-hidden mb-0">
                            <div class="card-body p-3">
                                <h6 class="text-uppercase fw-bold text-muted fs-11 mb-3">Resumen de Liquidación</h6>

                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Subtotal Bruto</span>
                                    <span id="pagoSubtotalDisplay" class="fw-medium text-dark">$ 0.00</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="text-muted">Descuento</span>
                                    <div class="input-group input-group-sm w-50">
                                        <span class="input-group-text bg-white">$</span>
                                        <input type="number" id="pagoDescuento" class="form-control text-end shadow-none fw-bold text-danger" value="0.00" step="0.01">
                                    </div>
                                </div>

                                <div class="p-3 bg-white rounded-2 border border-dashed border-primary mb-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="fs-13 fw-bold text-primary">A PAGAR</span>
                                        <h3 id="pagoTotalDisplay" class="mb-0 text-primary fw-bold" style="letter-spacing: -1px;">$ 0.00</h3>
                                    </div>
                                </div>

                                <div class="mb-0">
                                    <label class="form-label text-muted fs-11 fw-semibold mb-1">Forma de Pago</label>
                                    <select id="metodoPago" class="form-select form-select-sm border-primary-subtle">
                                        <option value="01">Sin utilización del sistema financiero (Efectivo)</option>
                                        <option value="20">Otros con utilización del sistema financiero (Tarjeta/Transferencia)</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer bg-light-subtle p-3">
                <button type="button" class="btn btn-ghost-danger shadow-none" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary btn-label right" id="btnConfirmarPago">
                    <i class="ri-send-plane-fill label-icon align-middle fs-16 ms-2"></i> Emitir y Enviar Comprobante
                </button>
            </div>
        </div>
    </div>
</div>

