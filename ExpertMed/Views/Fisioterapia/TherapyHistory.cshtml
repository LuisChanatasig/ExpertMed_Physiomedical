@using System.Text.Json
@using System.Text.Encodings.Web
@model List<TherapyHistoryDTO>
@inject JavaScriptEncoder _encoder

@{
    ViewBag.Title = "Gestión de Historial Clínico";
    Layout = "_Layout";
}

@* Inyección de datos al scope global de JS *@
<script>
    window.historialClinico = @Html.Raw(JsonSerializer.Serialize(Model));
</script>

<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between text-primary">
            <h4 class="mb-sm-0">Historial Clínico y Evolución</h4>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header border-0 align-items-center d-flex">
        <h5 class="card-title mb-0 flex-grow-1">
            <i class="mdi mdi-account-clock text-primary me-2"></i>Seguimiento de Evolución
        </h5>
        <div class="flex-shrink-0">
            <div class="input-group input-group-sm" style="width:300px;">
                <span class="input-group-text bg-light border-light"><i class="ri-search-line"></i></span>
                <input type="text" id="globalSearch" class="form-control bg-light border-light" placeholder="Buscar paciente...">
            </div>
        </div>
    </div>

    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            for (int pIdx = 0; pIdx < Model.Count; pIdx++)
            {
                var paciente = Model[pIdx];
                var safeId = "paciente_" + pIdx;

                <div class="grupo-historial card border mb-3 shadow-none">
                    <div class="card-header bg-light-subtle d-flex justify-content-between align-items-center py-2">
                        <div class="d-flex align-items-center">
                            <div class="avatar-xs me-3">
                                <div class="avatar-title bg-soft-primary text-primary rounded-circle fw-bold">
                                    @paciente.NombrePaciente.Substring(0, 1).ToUpper()
                                </div>
                            </div>
                            <div>
                                <h6 class="mb-0 fs-14">@paciente.NombrePaciente</h6>
                                <small class="text-muted">C.I: @paciente.CedulaPaciente</small>
                            </div>
                        </div>
                        <button class="btn btn-sm btn-outline-primary shadow-none" data-bs-toggle="collapse" data-bs-target="#@safeId">
                            <i class="mdi mdi-eye-outline me-1"></i> Detalles
                        </button>
                    </div>

                    <div class="collapse" id="@safeId">
                        <div class="card-body p-0">
                            @foreach (var solicitud in paciente.Solicitudes)
                            {
                                <div class="p-3 border-bottom bg-white">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <div class="fs-13">
                                            <span class="me-3"><i class="mdi mdi-doctor text-primary me-1"></i><strong>@solicitud.TerapeutaNombre</strong></span>
                                            <span class="badge bg-info-subtle text-info">@solicitud.FechaSolicitud.ToString("dd/MM/yyyy")</span>
                                        </div>

                                        <div class="d-flex gap-2">
                                            <button class="btn btn-sm btn-outline-dark" onclick="window.HistorialController.imprimirReporteEvolucion(@pIdx, @paciente.Solicitudes.IndexOf(solicitud))">
                                                <i class="ri-printer-line me-1"></i> Imprimir Evolución
                                            </button>
                                        </div>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-sm table-hover align-middle mb-0">
                                            <thead class="table-light fs-11 text-uppercase">
                                                <tr>
                                                    <th>Fecha</th>
                                                    <th>Terapia</th>
                                                    <th width="150">Avance</th>
                                                    <th width="100" class="text-center">Acciones</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @for (int i = 0; i < solicitud.Sesiones.Count; i++)
                                                {
                                                    var sesion = solicitud.Sesiones[i];
                                                    <tr>
                                                        <td class="fs-12">@sesion.Fecha.ToString("dd/MM/yyyy")</td>
                                                        <td><span class="badge bg-light text-body border">@sesion.Tipo</span></td>
                                                        <td>
                                                            <div class="progress progress-sm" style="height:6px;">
                                                                <div class="progress-bar bg-primary" style="width:@sesion.AvancePorcentaje%"></div>
                                                            </div>
                                                            <small class="text-muted">@sesion.AvancePorcentaje%</small>
                                                        </td>
                                                        <td class="text-center">
                                                            <button class="btn btn-sm btn-icon btn-soft-primary"
                                                                    title="Actualizar evolución"
                                                                    onclick="window.HistorialController.abrirModalAvance(@sesion.SessionId, @sesion.AvancePorcentaje, '@_encoder.Encode(sesion.AvanceNotas ?? "")')">
                                                                <i class="mdi mdi-pencil-outline"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5">
                <div class="avatar-lg mx-auto mb-3">
                    <div class="avatar-title bg-soft-primary text-primary rounded-circle fs-2">
                        <i class="mdi mdi-clipboard-text-outline"></i>
                    </div>
                </div>
                <h5 class="text-muted">No hay registros de historial clínico</h5>
                <p class="text-muted mb-0">Los historiales de evolución aparecerán aquí cuando haya sesiones registradas.</p>
            </div>
        }
    </div>
</div>

@* Modal de Avance *@
<div class="modal fade" id="modalAvance" tabindex="-1" aria-labelledby="modalAvanceLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary p-3">
                <h5 class="modal-title text-white d-flex align-items-center" id="modalAvanceLabel">
                    <i class="ri-line-chart-line me-2"></i>Seguimiento de Evolución
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <input type="hidden" id="avanceSessionId">

                <div class="mb-4">
                    <label class="form-label fw-bold text-muted mb-2">Porcentaje de Mejora</label>
                    <div class="text-center mb-3">
                        <h1 class="text-primary fw-bold mb-0" id="displayPorcentaje">0%</h1>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <input type="range" class="form-range flex-grow-1" id="avanceRange" min="0" max="100" step="5">
                        <div class="input-group input-group-sm" style="width: 80px;">
                            <input type="number" id="avancePorcentaje" class="form-control text-center fw-bold"
                                   min="0" max="100">
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between mt-1 text-muted fs-11">
                        <span>Sin cambios</span>
                        <span>Recuperación Total</span>
                    </div>
                </div>

                <div class="mb-0">
                    <label class="form-label fw-bold text-muted mb-2">
                        <i class="ri-file-edit-line me-1 text-primary"></i> Notas de Evolución
                    </label>
                    <textarea id="avanceNotas" class="form-control border-light-subtle shadow-none"
                              rows="5" placeholder="Describa el progreso del paciente en esta sesión..."></textarea>
                </div>
            </div>

            <div class="modal-footer bg-light-subtle">
                <button type="button" class="btn btn-ghost-danger" data-bs-dismiss="modal">
                    <i class="ri-close-line align-bottom me-1"></i> Cerrar
                </button>
                <button type="button" class="btn btn-primary" id="btnGuardarAvance">
                    <i class="ri-save-3-line align-bottom me-1"></i> Guardar Evolución
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        // Definición de URL dinámica desde Razor
        window.TherapyUrls = {
            updateProgress: '@Url.Action("UpdateAvance", "Fisioterapia")'
        };
    </script>
    <script src="~/assets/js/historial-gestion.js"></script>
}