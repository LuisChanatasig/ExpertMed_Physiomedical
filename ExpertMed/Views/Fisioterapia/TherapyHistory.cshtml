@section scripts {

    <script>
        // Definición de URLs dinámicas desde Razor
        window.TherapyUrls = {
            updateProgress: '@Url.Action("UpdateAvance", "Fisioterapia")',
            processInvoice: '@Url.Action("ProcessTherapyInvoice", "Billing")'
        };
    </script>
    <script src="~/assets/js/historial-gestion.js"></script>
}