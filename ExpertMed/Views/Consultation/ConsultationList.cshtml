@using Microsoft.AspNetCore.Http
@model List<ExpertMed.Models.ConsultationGroupViewModel>

@{
    ViewBag.Title = "Listado de Consultas";
    ViewBag.pTitle = "Listado de Consultas";
    ViewBag.pageTitle = "Listado de Consultas";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var perfilId = ViewContext.HttpContext.Session.GetInt32("PerfilId");

    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
}

@section styles {
    <style>
        .status-badge {
            font-size: 0.75rem;
            padding: 0.35rem 0.65rem;
            font-weight: 500;
        }
        .grupo-consulta {
            transition: all 0.3s ease;
        }
        .grupo-consulta:hover {
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.075);
        }
    </style>
}

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <div class="row align-items-center g-3">
                    <div class="col-md-3">
                        <h5 class="card-title mb-0">
                            <i class="mdi mdi-clipboard-text-multiple-outline"></i> 
                            Consultas Médicas
                        </h5>
                    </div>
                    <div class="col-md-4">
                        <input type="text" id="consultaSearch" 
                               class="form-control form-control-sm" 
                               placeholder="🔍 Buscar paciente, médico o especialidad..." />
                    </div>
                    <div class="col-md-5">
                        <div class="d-flex justify-content-end gap-3">
                            <div class="text-center">
                                <small class="text-muted d-block">Pacientes</small>
                                <strong class="fs-5 text-primary">@(ViewBag.TotalPacientes ?? Model.Count)</strong>
                            </div>
                            <div class="text-center">
                                <small class="text-muted d-block">Total Consultas</small>
                                <strong class="fs-5 text-info">@(ViewBag.TotalConsultas ?? Model.Sum(g => g.TotalConsultas))</strong>
                            </div>
                            <div class="text-center">
                                <small class="text-muted d-block">Pendientes</small>
                                <strong class="fs-5 text-danger">@(ViewBag.ConsultasPendientes ?? Model.Sum(g => g.Consultas.Count(c => c.AppointmentStatus != 4)))</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
             <!-- Paginación arriba -->
            <div class="d-flex justify-content-between align-items-center p-2">
                <span class="text-muted">Página @ViewBag.Page</span>

                <div class="btn-group">
                    <a asp-action="ConsultationList"
                       asp-route-patientId="@Context.Request.Query["patientId"]"
                       asp-route-page="@(ViewBag.Page - 1)"
                       asp-route-pageSize="@ViewBag.PageSize"
                        class="btn btn-sm btn-outline-secondary @((ViewBag.HasPrevious ?? false) ? "" : "disabled")">
                        ← Anterior
                    </a>

                    <a asp-action="ConsultationList"
                       asp-route-patientId="@Context.Request.Query["patientId"]"
                       asp-route-page="@(ViewBag.Page + 1)"
                       asp-route-pageSize="@ViewBag.PageSize"
class="btn btn-sm btn-outline-primary @((ViewBag.HasNext ?? false) ? "" : "disabled")">
                        Siguiente →
                    </a>
                </div>
            </div>
            <div class="card-body">


                @if (Model != null && Model.Any())
                {
                    int grupoId = 1;
                    foreach (var grupo in Model)
                    {
                        var firstConsulta = grupo.PrimeraConsulta;
                        var collapseId = $"collapseConsulta{grupoId}";

                        <div class="mb-3 border rounded grupo-consulta">
                            <div class="bg-light px-3 py-2">
                                <div class="row align-items-center">
                                    <div class="col-md-8">
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <strong>
                                                <i class="mdi mdi-account"></i> @grupo.PacienteNombre
                                            </strong>
                                            <span class="badge bg-secondary status-badge">
                                                @grupo.TotalConsultas consulta@(grupo.TotalConsultas > 1 ? "s" : "")
                                            </span>
                                            @if (firstConsulta != null)
                                            {
                                                <span class="badge @(firstConsulta.AppointmentStatus == 4 ? "bg-success" : "bg-danger") status-badge">
                                                    @if (firstConsulta.AppointmentStatus == 4)
                                                    {
                                                        <i class="mdi mdi-check-circle"></i> <text>Finalizada</text>
                                                    }
                                                    else
                                                    {
                                                        <i class="mdi mdi-alert-circle"></i> <text>Pendiente</text>
                                                    }
                                                </span>
                                            }
                                        </div>
                                        @if (firstConsulta != null)
                                        {
                                            <div class="text-muted small">
                                                <i class="mdi mdi-stethoscope"></i>
                                                Médico: @grupo.UltimaMedicoNombre
                                            </div>
                                            <div class="text-muted small">
                                                <i class="mdi mdi-calendar-clock"></i>
                                                Última consulta: @(grupo.UltimaConsulta?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                                            </div>
                                        }
                                    </div>
                                    <div class="col-md-4 text-end">
                                        <a class="btn btn-sm btn-soft-info" data-bs-toggle="collapse" 
                                           href="#@collapseId" role="button" aria-expanded="false" aria-controls="@collapseId">
                                            <i class="mdi mdi-eye-outline"></i> Ver detalles
                                        </a>
                                        <a href="@Url.Action("AppointmentList", "Appointment")" 
                                           class="btn btn-sm btn-soft-primary">
                                            <i class="bx bx-user-plus"></i> Nueva
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <div class="collapse px-2 py-2" id="@collapseId">
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover table-bordered align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                @if (perfilId == 1 || perfilId == 2)
                                                {
                                                    <th>Secuencial</th>
                                                    <th>Médico</th>
                                                }
                                                <th>H. Clínica</th>
                                                <th>Fecha</th>
                                                <th>Especialidad</th>
                                                <th>Motivo</th>
                                                <th>Tipo</th>
                                                <th>Estado</th>
                                                <th>Acción</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var consulta in grupo.Consultas)
                                            {
                                                <tr>
                                                    @if (perfilId == 1 || perfilId == 2)
                                                    {
                                                        <td>@consulta.ConsultationId</td>
                                                        <td>
                                                            @if (consulta.ConsultationUsercreateNavigation != null)
                                                            {
                                                                <div class="d-flex align-items-center fw-medium">
                                                                    <img src="~/assets/images/svg/medicUsers.svg" alt="" class="avatar-xxs me-2" />
                                                                    @consulta.ConsultationUsercreateNavigation.UsersNames @consulta.ConsultationUsercreateNavigation.UsersSurcenames
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted">No asignado</span>
                                                            }
                                                        </td>
                                                    }
                                                    <td>@consulta.ConsultationHistoryclinic</td>
                                                    <td>@(consulta.ConsultationCreationdate?.ToString("dd/MM/yyyy") ?? "")</td>
                                                    <td>@(consulta.ConsultationSpecialityNavigation?.SpecialityName ?? "No especificada")</td>
                                                    <td>@(consulta.ConsultationReason ?? "—")</td>
                                                    <td>
                                                        <span class="badge @(consulta.ConsultationType == 1 ? "bg-success-subtle text-success" : "bg-info-subtle text-info")">
                                                            @(consulta.ConsultationType == 1 ? "Principal" : consulta.ConsultationType == 2 ? "Seguimiento" : "Otro")
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <span class="badge @(consulta.AppointmentStatus == 4 ? "bg-success" : "bg-danger") status-badge">
                                                            @if (consulta.AppointmentStatus == 4)
                                                            {
                                                                <i class="mdi mdi-check"></i> <text>Finalizada</text>
                                                            }
                                                            else
                                                            {
                                                                <i class="mdi mdi-clock-outline"></i> <text>Pendiente</text>
                                                            }
                                                        </span>
                                                    </td>
                                                    <td>
                                                        @if (consulta.AppointmentStatus == 4)
                                                        {
                                                            if (consulta.ConsultationCreationdate?.Date == DateTime.Today)
                                                            {
                                                                <a href="@Url.Action("ConsultationUpdate", "Consultation", new { consultationId = consulta.ConsultationId })"
                                                                   class="btn btn-sm btn-soft-warning">
                                                                    <i class="ri-edit-line"></i> Editar
                                                                </a>
                                                            }
                                                            <a href="#" class="btn btn-sm btn-soft-success"
                                                               data-bs-toggle="modal" data-bs-target="#optionModal"
                                                               onclick="openOptionModal(@consulta.ConsultationId, @consulta.AppointmentStatus)">
                                                                <i class="ri-eye-line"></i> Revisar
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <a href="#" class="btn btn-sm btn-soft-warning"
                                                               data-bs-toggle="modal" data-bs-target="#optionModal"
                                                               onclick="openOptionModal(@consulta.ConsultationId, @consulta.AppointmentStatus)">
                                                                <i class="ri-edit-line"></i> Completar
                                                            </a>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        grupoId++;
                    }
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="mdi mdi-information-outline fs-1 d-block mb-2"></i>
                        No hay consultas registradas.
                    </div>
                }
            </div>
            <!-- Paginación abajo -->
            <div class="d-flex justify-content-between align-items-center p-3">
                <span class="text-muted">Página @ViewBag.Page</span>

                <div class="btn-group">
                    <a asp-action="ConsultationList"
                       asp-route-patientId="@Context.Request.Query["patientId"]"
                       asp-route-page="@(ViewBag.Page - 1)"
                       asp-route-pageSize="@ViewBag.PageSize"
class="btn btn-sm btn-outline-secondary @((ViewBag.HasPrevious ?? false) ? "" : "disabled")">
                        ← Anterior
                    </a>

                    <a asp-action="ConsultationList"
                       asp-route-patientId="@Context.Request.Query["patientId"]"
                       asp-route-page="@(ViewBag.Page + 1)"
                       asp-route-pageSize="@ViewBag.PageSize"
class="btn btn-sm btn-outline-primary @((ViewBag.HasNext ?? false) ? "" : "disabled")">
                        Siguiente →
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!--Modal opciones consulta-->
<div class="modal flip" id="optionModal" tabindex="-1" aria-labelledby="exampleModalgridLabel" aria-modal="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <input type="hidden" id="consultationId" name="ConsultationId" />
            <input type="hidden" id="perfiltIdInput" value="@perfilId" name="perfil" />

            <div class="modal-header">
                <h5 class="modal-title" id="optionModal">¿Qué desea hacer con esta consulta?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-6">
                        <button type="button" class="btn btn-soft-info btn-label btn-sm w-100 waves-effect waves-light"
                                onclick="openReviewConsulta()">
                            <i class="ri-eye-fill label-icon align-middle fs-16 me-2"></i> Revisar Consulta
                        </button>
                    </div>
                    <div class="col-6">
                        <button type="button" class="btn btn-soft-success btn-label btn-sm w-100 waves-effect waves-light"
                                onclick="openModalDocument()">
                            <i class="ri-file-text-fill label-icon align-middle fs-16 me-2"></i> Generar Documento
                        </button>
                    </div>
                    <button id="btnFinishConsult"
                            type="button"
                            class="btn btn-success d-none"
                            onclick="finishConsultation()">
                        <i class="ri-check-line me-1"></i> Terminar Consulta
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!--Modal opciones documentos-->
<div class="modal fade" id="optionsDocuments" tabindex="-1" aria-labelledby="optionsDocuments">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="optionsDocuments">¿Qué documento desea generar?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
<div class="modal-body">
    <form action="javascript:void(0);">
        <div class="row g-3">
            <select class="form-select mb-3" id="documentType" aria-label="Seleccione un documento" onchange="enableDownloadButton()">
                <option selected>Seleccione un documento</option>
                <option value="justificante">Certificado Médico</option>
                <option value="formulario">Formulario Médico antiguo</option>
                <option value="formulario2" class="new-form-highlight">Formulario Médico 2026</option> 
                <option value="receta">Receta</option>
                <option value="laboratorio">Laboratorio</option>
                <option value="imagen">Imagen</option>
            </select>
        </div>
    </form>
</div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" id="downloadButton" onclick="downloadDocument()" disabled>
                    <span id="downloadText">Descargar</span>
                    <span id="downloadSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/assets/js/app.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js" integrity="sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4=" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        function openOptionModal(consultationId, appointmentStatus) {
            console.log('Estado de la cita:', appointmentStatus);
            document.getElementById('consultationId').value = consultationId;
            const btnFinish = document.getElementById('btnFinishConsult');
            
            if (appointmentStatus === 4) {
                btnFinish.classList.add('d-none');
            } else {
                btnFinish.classList.remove('d-none');
            }
            
            new bootstrap.Modal(document.getElementById('optionModal'), { keyboard: false }).show();
        }

        function finishConsultation() {
            const id = document.getElementById('consultationId').value;
            window.location.href = '@Url.Action("ConsultationUpdate", "Consultation")' + '?consultationId=' + encodeURIComponent(id);
        }

        function openModalDocument() {
            const modalElement = document.getElementById('optionsDocuments');
            if (!modalElement) {
                console.error("El modal 'optionsDocuments' no fue encontrado.");
                return;
            }
            new bootstrap.Modal(modalElement, { keyboard: false }).show();
        }

        function openReviewConsulta() {
            const consultationId = document.getElementById('consultationId').value;
            if (!consultationId) {
                alert("No se encontró un ID de consulta válido.");
                return;
            }
            window.location.href = '@Url.Action("ConsultationDetails", "Consultation")' + '?consultationId=' + encodeURIComponent(consultationId);
        }

        function enableDownloadButton() {
            const selectedValue = document.getElementById('documentType').value;
            const downloadButton = document.getElementById('downloadButton');
            if (!downloadButton) {
                console.error("Botón de descarga no encontrado.");
                return;
            }
            downloadButton.disabled = (selectedValue === "Seleccione un documento");
        }

        function downloadDocument() {
            const selectedValue = document.getElementById('documentType').value;
            const downloadButton = document.getElementById('downloadButton');
            const downloadText = document.getElementById('downloadText');
            const downloadSpinner = document.getElementById('downloadSpinner');
            const consultationId = document.getElementById('consultationId').value;

            if (!consultationId) {
                alert("No se encontró un ID de consulta válido.");
                return;
            }
            if (!downloadButton || !downloadText || !downloadSpinner) {
                console.error("Elementos del botón de descarga no encontrados.");
                return;
            }

            downloadText.textContent = "Generando...";
            downloadSpinner.classList.remove('d-none');
            downloadButton.disabled = true;

            const actions = {
                justificante: '@Url.Action("MedicalCertificate", "Documents")',
                formulario: '@Url.Action("MedicalForm", "Documents")',
                formulario2: '@Url.Action("MedicalForm2", "Documents")',
                receta: '@Url.Action("MedicationRecipe", "Documents")',
                laboratorio: '@Url.Action("LaboratoryDoc", "Documents")',
                imagen: '@Url.Action("ImageDoc", "Documents")'
            };

            if (actions[selectedValue]) {
                const url = actions[selectedValue] + '?consultationId=' + encodeURIComponent(consultationId);
                window.open(url, '_blank');
            } else {
                alert("Opción no válida.");
            }

            setTimeout(() => {
                downloadText.textContent = "Descargar";
                downloadSpinner.classList.add('d-none');
                downloadButton.disabled = false;
            }, 2000);
        }

         function changePageSize() {
            const size = document.getElementById("pageSizeSelect").value;
            window.location.href = '@Url.Action("ConsultationList", "Consultation")'
                + '?page=1&pageSize=' + size;
        }
        $(document).ready(function () {
            // Búsqueda en tiempo real
            $('#consultaSearch').on('keyup', function () {
                var filtro = $(this).val().toLowerCase();
                
                $('.grupo-consulta').each(function () {
                    var textoGrupo = $(this).text().toLowerCase();
                    var match = textoGrupo.indexOf(filtro) > -1;
                    $(this).toggle(match);
                });
            });
        });
    </script>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <script>
            Swal.fire({
                title: '¡Éxito!',
                text: '@successMessage',
                icon: 'success',
                confirmButtonText: 'OK',
                timer: 3000
            });
        </script>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <script>
            Swal.fire({
                title: 'Error',
                text: '@errorMessage',
                icon: 'error',
                confirmButtonText: 'OK',
                timer: 3000
            });
        </script>
    }
}