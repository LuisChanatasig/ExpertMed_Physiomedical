@section Scripts {
    <script>
        const consultaUrl = '@Url.Action("CrearConsulta", "Consultation")';
        const redirectUrl = '@Url.Action("ConsultationList", "Consultation")';
        const addFavoriteUrl = '@Url.Action("AddOrUpdate", "FavoriteMedication")';
        const getFavoritesUrl = '@Url.Action("List", "FavoriteMedication")';
        const deleteFavoriteUrl = '@Url.Action("Delete", "FavoriteMedication")';
        const createMedicationUrl = '@Url.Action("CreateMedication", "Consultation")'; // NUEVA URL
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const switches = document.querySelectorAll(".form-check-input");

            switches.forEach(switchElement => {
                switchElement.addEventListener("change", function () {
                    const parentDiv = this.closest(".form-check");
                    const nextSibling = parentDiv?.nextElementSibling;
                    const nextNextSibling = nextSibling?.nextElementSibling;

                    const selectField = nextSibling?.querySelector("select");
                    const observationField = nextNextSibling?.querySelector("input");

                    if (this.checked) {
                        if (selectField) {
                            const selectContainer = selectField.closest(".col-lg-5");
                            if (selectContainer) selectContainer.style.display = "block";
                        }
                        if (observationField) {
                            const obsContainer = observationField.closest(".col-lg-5");
                            if (obsContainer) obsContainer.style.display = "block";
                        }
                    } else {
                        if (selectField) {
                            const selectContainer = selectField.closest(".col-lg-5");
                            if (selectContainer) selectContainer.style.display = "none";
                        }
                        if (observationField) {
                            const obsContainer = observationField.closest(".col-lg-5");
                            if (obsContainer) obsContainer.style.display = "none";
                        }
                    }
                });

                const parentDiv = switchElement.closest(".form-check");
                const nextSibling = parentDiv?.nextElementSibling;
                const nextNextSibling = nextSibling?.nextElementSibling;

                const selectField = nextSibling?.querySelector("select");
                const observationField = nextNextSibling?.querySelector("input");

                if (selectField) {
                    const selectContainer = selectField.closest(".col-lg-5");
                    if (selectContainer) selectContainer.style.display = "none";
                }

                if (observationField) {
                    const obsContainer = observationField.closest(".col-lg-5");
                    if (obsContainer) obsContainer.style.display = "none";
                }
            });
        });
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
          const requireOn = true;

          const groups = {
            personal_background: [
              "heartdisease",
              "hypertension",
              "dxcardiovascular",
              "endometabolic",
              "cancer",
              "tuberculosis",
              "dxmental",
              "dxinfectious",
              "malformation",
              "other"
            ],
            organssystems: [
              "skin",
              "organsenses",
              "respiratory",
              "cardiovascular",
              "digestive",
              "genital",
              "urinary",
              "skeletal_m",
              "endocrine",
              "lymphatic",
              "nervous"
            ],
            physicalexamination: [
              "skinfaneras",
              "head",
              "eyes",
              "ears",
              "nose",
              "mouth",
              "oropharynx",
              "neck",
              "axilasmamas",
              "chest",
              "abdomen",
              "spine",
              "ingleperine",
              "upperlimbs",
              "lowerlimbs",
              "pelvis"
            ]
          };

          const bind = (prefix, keys) => {
            keys.forEach(key => {
              const chk = document.getElementById(`${prefix}_${key}`);
              const wrap = document.getElementById(`${prefix}_${key}_wrapper`);
              const obs =
                document.getElementById(`${prefix}_${key}_obs`) ||
                document.getElementById(`${prefix}_${key}_Obs`);

              if (!chk || !wrap) return;

              const update = () => {
                wrap.style.display = chk.checked ? "block" : "none";
                if (obs && requireOn) obs.required = chk.checked;
              };

              update();
              chk.addEventListener("change", update);
            });
          };

          Object.entries(groups).forEach(([prefix, keys]) => bind(prefix, keys));
        });
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const peso = document.getElementById("consultation_weight");
            const talla = document.getElementById("consultation_size");
            const imc = document.getElementById("consultation_bmi");

            function calcIMC(){
                const p = parseFloat(peso.value);
                const t = parseFloat(talla.value) / 100;
                if(!isNaN(p) && !isNaN(t) && t > 0){
                    imc.value = (p / (t*t)).toFixed(2);
                }
            }

            peso.addEventListener("input", calcIMC);
            talla.addEventListener("input", calcIMC);
        });
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            Array.from(document.querySelectorAll(".form-steps")).forEach(function (form) {
                Array.from(form.querySelectorAll(".nexttab")).forEach(function (nextButton) {
                    nextButton.addEventListener("click", function () {
                        var currentTab = nextButton.closest(".tab-pane");
                        var inputs = currentTab.querySelectorAll(".form-control");
                        var isValid = true;

                        inputs.forEach(function (input) {
                            if (!input.checkValidity()) {
                                input.classList.add("is-invalid");
                                isValid = false;
                            } else {
                                input.classList.remove("is-invalid");
                                input.classList.add("is-valid");
                            }
                        });

                        if (isValid) {
                            var nextTabId = nextButton.getAttribute('data-nexttab');
                            var nextTab = document.getElementById(nextTabId);
                            if (nextTab) {
                                var tab = new bootstrap.Tab(nextTab);
                                tab.show();
                                form.classList.remove("was-validated");
                            }
                        } else {
                            form.classList.add("was-validated");
                        }
                    });
                });

                Array.from(form.querySelectorAll(".previestab")).forEach(function (prevButton) {
                    prevButton.addEventListener("click", function () {
                        var prevTabId = prevButton.getAttribute('data-previous');
                        var prevTab = document.getElementById(prevTabId);
                        if (prevTab) {
                            var tab = new bootstrap.Tab(prevTab);
                            tab.show();
                        }
                    });
                });
            });
        });
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const allergiesSelect = document.getElementById('allergiesSelect');
            const selectedAllergiesIdsInput = document.getElementById('selectallergiesId');

            if (allergiesSelect && selectedAllergiesIdsInput) {
                allergiesSelect.addEventListener('change', function () {
                    const selectedOptions = Array.from(allergiesSelect.selectedOptions).map(option => option.value);
                    selectedAllergiesIdsInput.value = selectedOptions.join(',');
                });
            }

            const surgeriesSelect = document.getElementById('surgeriesSelect');
            const selectSurgeriesIdsInput = document.getElementById('selectSurgeriesId');

            if (surgeriesSelect && selectSurgeriesIdsInput) {
                surgeriesSelect.addEventListener('change', function () {
                    const selectedOptions = Array.from(surgeriesSelect.selectedOptions).map(option => option.value);
                    selectSurgeriesIdsInput.value = selectedOptions.join(',');
                });
            }
        });
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const checkbox = document.getElementById("cert_tiene_enfermedad");
            const obsContainer = document.getElementById("observacion_container");

            if (checkbox && obsContainer) {
                checkbox.addEventListener("change", function () {
                    obsContainer.style.display = this.checked ? "block" : "none";
                });
