    <!-- Inicialización de Select2 y Modal de Medicamentos -->
    <script>
        (function waitForDependencies() {
            if (typeof window.jQuery === 'undefined' ||
                typeof window.jQuery.fn.select2 === 'undefined' ||
                typeof window.bootstrap === 'undefined') {
                setTimeout(waitForDependencies, 50);
                return;
            }

            jQuery(document).ready(function($) {
                // Inicializar selects normales
                const selects = ['DiagnosisConsultation', 'LaboratoriesConsultation', 'ImagesConsultation'];

                selects.forEach(function(id) {
                    const elem = document.getElementById(id);
                    if (elem) {
                        $(elem).select2({
                            placeholder: 'Busque y seleccione',
                            allowClear: true,
                            width: '100%',
                            language: 'es'
                        });
                    }
                });

                // Medicamentos con opción de agregar
                const medElem = document.getElementById('MedicationsConsultation');
                if (medElem) {
                    $(medElem).select2({
                        placeholder: 'Escriba y seleccione un medicamento',
                        allowClear: true,
                        width: '100%',
                        language: {
                            noResults: function() {
                                return "No encontrado. <button type='button' class='btn btn-sm btn-link p-0' id='agregarDesdeSelect'>¿Agregar nuevo?</button>";
                            }
                        },
                        escapeMarkup: function(m) { return m; }
                    });
                }

                // Eventos del modal - Usando Bootstrap nativo
                $(document).on('click', '#btnNuevoMedicamento, #agregarDesdeSelect', function(e) {
                    e.preventDefault();
                    let searchTerm = '';

                    if (this.id === 'agregarDesdeSelect') {
                        try {
                            searchTerm = $('.select2-search__field').last().val() || '';
                        } catch(err) {
                            console.warn('No se pudo obtener término de búsqueda');
                        }
                    }

                    const modalEl = document.getElementById('modalNuevoMedicamento');
                    if (modalEl) {
                        const modal = new bootstrap.Modal(modalEl);
                        modal.show();
                    }

                    $('#formNuevoMedicamento')[0].reset();
                    $('#alertMedicamento').addClass('d-none');

                    if (searchTerm) {
                        $('#medications_name').val(searchTerm.toUpperCase());
                    }
                });

                // Auto-convertir a mayúsculas
                $('#medications_name').on('input', function() {
                    this.value = this.value.toUpperCase();
                });

                // Guardar medicamento
                $('#btnGuardarMedicamento').on('click', function() {
                    const form = $('#formNuevoMedicamento')[0];
                    if (!form.checkValidity()) {
                        form.classList.add('was-validated');
                        return;
                    }

                    $(this).prop('disabled', true);
                    $('#spinnerGuardar').removeClass('d-none');

                    $.ajax({
                        url: createMedicationUrl, // Usar la variable definida arriba
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({
                            medications_name: $('#medications_name').val().trim(),
                            medications_description: $('#medications_description').val().trim(),
                            medications_concentration: $('#medications_concentration').val().trim(),
                            medications_cie10: $('#medications_cie10').val().trim(),
                            medications_status: 1
                        }),
                        success: function(res) {
                            if (res.success) {
                                const text = res.data.medications_description || res.data.medications_name;
                                const opt = new Option(text, res.data.medications_id, true, true);
                                $('#MedicationsConsultation').append(opt).trigger('change');

                                // Cerrar modal usando Bootstrap nativo
                                const modalEl = document.getElementById('modalNuevoMedicamento');
                                if (modalEl) {
                                    const modal = bootstrap.Modal.getInstance(modalEl);
                                    if (modal) modal.hide();
                                }

                                if (typeof Swal !== 'undefined') {
                                    Swal.fire({
                                        icon: 'success',
                                        title: 'Agregado',
                                        text: 'Medicamento listo para usar',
                                        timer: 2000,
                                        showConfirmButton: false
                                    });
                                }
                            } else {
                                $('#alertMedicamento').removeClass('d-none').addClass('alert-danger')
                                    .text(res.message || 'Error');
                            }
                        },
                        error: function(xhr) {
                            $('#alertMedicamento').removeClass('d-none').addClass('alert-danger')
                                .text(xhr.responseJSON?.message || 'Error del servidor');
                        },
                        complete: function() {
                            $('#btnGuardarMedicamento').prop('disabled', false);
                            $('#spinnerGuardar').addClass('d-none');
                        }
                    });
                });

                $('#formNuevoMedicamento input').on('input', function() {
                    $('#alertMedicamento').addClass('d-none');
                });
            });
        })();

        document.addEventListener('DOMContentLoaded', function() {
            const btnAdd = document.getElementById('addOtherStudy');
            const inputName = document.getElementById('otherStudyName');
            const inputIndication = document.getElementById('otherStudyIndication');
            const tableBody = document.querySelector('#tableOtherStudies tbody');

            btnAdd.addEventListener('click', function() {
                const name = inputName.value.trim();
                const indication = inputIndication.value.trim();

                if (name === "") {
                    inputName.classList.add('is-invalid');
                    return;
                }
                inputName.classList.remove('is-invalid');

                const row = `
                    <tr>
                        <td>
                            <input type="hidden" name="OtherStudyNames[]" value="${name}">
                            <strong>${name}</strong>
                        </td>
                        <td>
                            <input type="text" name="OtherStudyIndications[]" class="form-control form-control-sm" value="${indication}">
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-outline-danger btn-sm remove-study">
                                <i class="ri-delete-bin-line"></i>
                            </button>
                        </td>
                    </tr>
                `;

                tableBody.insertAdjacentHTML('beforeend', row);

                // Limpiar campos y dar foco al nombre para el siguiente ingreso
                inputName.value = "";
                inputIndication.value = "";
                inputName.focus();
            });

            // Eliminar fila
            tableBody.addEventListener('click', function(e) {
                if (e.target.closest('.remove-study')) {
                    e.target.closest('tr').remove();
                }
            });
        });
    </script>



    <script src="~/assets/js/consultation.js"></script>
