@using Microsoft.AspNetCore.Http

@{
    ViewBag.Title = "Crear Usuario";
    ViewBag.pTitle = "Crear Usuario";
    ViewBag.pageTitle = "Crear Usuario";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
    var perfilId = ViewContext.HttpContext.Session.GetInt32("PerfilId");

}
@model NewUserViewModel

@section styles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://unpkg.com/filepond/dist/filepond.min.css" rel="stylesheet" />
    <link href="https://unpkg.com/filepond-plugin-image-preview/dist/filepond-plugin-image-preview.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css" rel="stylesheet" />
}

<div class="position-relative mx-n4 mt-n4">
    <div class="profile-wid-bg profile-setting-img">
        <img src="~/assets/images/auth-one-bg.jpg" class="profile-wid-img" alt="">
        <div class="overlay-content">
            <div class="text-end p-3">
                <div class="p-0 ms-auto rounded-circle profile-photo-edit">
                    <input id="profile-foreground-img-file-input" type="file" class="profile-foreground-img-file-input">
                    <h1 class="cabeceras"><i class="ri-survey-fill"></i> REGISTRAR NUEVO USUARIO</h1>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <form asp-action="NewUser" asp-controller="Users" method="post" class="row g-3 needs-validation" novalidate enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <!-- Foto perfil -->
        <div class="col-xxl-3">
            <div class="card mt-n5">
                <div class="card-body p-4">
                    <div class="text-center">
                        <div class="profile-user position-relative d-inline-block mx-auto mb-4">
                            <img src="~/assets/images/users/avatar-1.jpg" class="rounded-circle avatar-xl img-thumbnail user-profile-image" alt="user-profile-image">
                            <div class="avatar-xs p-0 rounded-circle profile-photo-edit">
                                <input type="file" class="profile-img-file-input" id="profile-img-file-input" name="ProfilePhoto" accept="image/*" required>
                                <label for="profile-img-file-input" class="profile-photo-edit avatar-xs">
                                    <span class="avatar-title rounded-circle bg-light text-body">
                                        <i class="ri-camera-fill"></i>
                                    </span>
                                </label>
                            </div>
                        </div>
                        <h5 class="fs-16 mb-1">Seleccione una foto de perfil</h5>
                    </div>
                </div>
            </div>
        </div>

        <!-- Datos -->
        <div class="col-xxl-12">
            <div class="card mt-xxl-n5">
                <div class="card-body p-4">
                    <div class="tab-content">
                        <div class="tab-pane active" id="personalDetails" role="tabpanel">
                            <div class="row">

                                <!-- Perfil -->
                                <div class="col-lg-3">
                                    <div class="mb-3">
                                        <label for="profileSelect" class="form-label">Seleccione el perfil</label>
                                        <select class="form-control" id="profileSelect" name="UserProfileid" required>
                                            @foreach (var profile in Model.Profiles)
                                            {
                                                <option value="@profile.ProfileId">@profile.ProfileName</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                <!-- Doctores (múltiple) visible si perfil=3 -->
                                <div class="col-lg-12" id="doctorSelectContainer" style="display:none;">
                                    <div class="mb-3">
                                        <label for="doctorSelect" class="form-label">Seleccione el doctor al cual asignar el Enfermero/a o Asistente</label>
                                        <select class="form-control" id="doctorSelect" name="doctorSelect" multiple>
                                            <option value="__all__">-- Seleccionar todos --</option>
                                            @foreach (var medic in Model.Users)
                                            {
                                                <option value="@Html.Raw(medic.UsersId)">
                                                    @Html.Raw($"Dr(a): {medic.UsersNames} {medic.UsersSurcenames} ({medic.UsersSpeciality.SpecialityName})")
                                                </option>
                                            }
                                        </select>
                                        <input type="hidden" id="selectedDoctorIds" name="selectedDoctorIds" />
                                    </div>
                                </div>

                                <!-- Documento -->
                                <div class="col-lg-3">
                                    <div class="mb-3">
                                        <label for="documentNumberInput" class="form-label">Número de documento</label>
                                        <input type="text" class="form-control" id="documentNumberInput" name="UserDocumentNumber" placeholder="1759999999" required />
                                        <div class="invalid-feedback">POR FAVOR ESTE CAMPO ES REQUERIDO</div>
                                    </div>
                                </div>

                                <!-- Nombres -->
                                <div class="col-lg-3">
                                    <div class="mb-3">
                                        <label for="firstnameInput" class="form-label">Nombres</label>
                                        <input type="text" class="form-control" id="firstnameInput" name="UserNames" placeholder="Ingrese sus nombres" required />
                                        <div class="invalid-feedback">POR FAVOR ESTE CAMPO ES REQUERIDO</div>
                                    </div>
                                </div>

                                <!-- Apellidos -->
                                <div class="col-lg-3">
                                    <div class="mb-3">
                                        <label for="lastnameInput" class="form-label">Apellidos</label>
                                        <input type="text" class="form-control" id="lastnameInput" name="UserSurnames" placeholder="Ingrese sus apellidos" required />
                                        <div class="invalid-feedback">POR FAVOR ESTE CAMPO ES REQUERIDO</div>
                                    </div>
                                </div>

                                <!-- Dirección + mapa -->
                                <div class="col-lg-12">
                                    <div class="mb-3">
                                        <label for="addressInput" class="form-label">Dirección</label>
                                        <div class="input-group">
                                            <input type="text" id="addressInput" class="form-control" name="UserAddress" placeholder="Escribe una dirección" required />
                                            <button class="btn btn-outline-success" type="button" id="mapButton"><i class="ri-map-pin-line"></i></button>
                                            <div class="invalid-feedback">POR FAVOR ESTE CAMPO ES REQUERIDO</div>
                                        </div>
                                        <div id="map" style="display:none; height:400px; margin-top:15px;"></div>
                                        <div id="suggestions" class="suggestions-container" style="display:none;"></div>
                                    </div>
                                </div>

                                <!-- Senecyt -->
                                <div class="col-lg-3">
                                    <div class="mb-3">
                                        <label for="codeSenecytInput" class="form-label">Código SENESCYT</label>
                                        <input type="text" class="form-control" id="codeSenecytInput" name="UserSenecytcode" placeholder="Ingrese su código del SENESCYT" required />
                                        <div class="invalid-feedback">POR FAVOR ESTE CAMPO ES REQUERIDO</div>
                                    </div>
                                </div>

                                <!-- Teléfono -->
                                <div class="col-lg-3">
                                    <div class="mb-3">
                                        <label for="phonenumberInput" class="form-label">Número de teléfono</label>
                                        <input type="text" class="form-control" id="phonenumberInput" name="UserPhone" placeholder="Ingrese su número de teléfono" required />
                                        <div class="invalid-feedback">POR FAVOR ESTE CAMPO ES REQUERIDO</div>
                                    </div>
                                </div>

                                <!-- Email -->
                                <div class="col-lg-3">
                                    <div class="mb-3">
                                        <label for="emailInput" class="form-label">Email</label>
                                        <input type="email" class="form-control" id="emailInput" name="UserEmail" placeholder="email@dominio.com" required />
                                        <div class="invalid-feedback">POR FAVOR ESTE CAMPO ES REQUERIDO, O NO ES UN EMAIL VÁLIDO</div>
                                    </div>
                                </div>

                                <!-- Especialidad -->
                                <div class="col-lg-3">
                                    <div class="mb-3">
                                        <label for="specialtyId" class="form-label">Seleccione su especialidad</label>
                                        <select class="form-control" id="specialtyId" name="UserSpecialtyid" required>
                                            @foreach (var specialities in Model.Specialties)
                                            {
                                                <option value="@specialities.SpecialityId">@specialities.SpecialityName</option>
                                            }
                                        </select>
                                        <div class="invalid-feedback">POR FAVOR ESTE CAMPO ES REQUERIDO</div>
                                    </div>
                                </div>

                                <!-- País -->
                                <div class="col-lg-6">
                                    <div class="mb-3">
                                        <label for="countryId" class="form-label">Seleccione su país</label>
                                        <select class="form-control" id="countryId" name="UserCountryid" required>
                                            @foreach (var countries in Model.Countries)
                                            {
                                                <option value="@countries.CountryId">@countries.CountryNationality</option>
                                            }
                                        </select>
                                        <div class="invalid-feedback">POR FAVOR ESTE CAMPO ES REQUERIDO</div>
                                    </div>
                                </div>

                                <!-- Login -->
                                <div class="col-lg-3">
                                    <div class="mb-3">
                                        <label for="loginInput" class="form-label">Log-in</label>
                                        <input type="text" class="form-control" id="loginInput" name="UserLogin" placeholder="nickname" required />
                                        <div class="invalid-feedback">POR FAVOR ESTE CAMPO ES REQUERIDO</div>
                                    </div>
                                </div>

                                <!-- Password -->
                                <div class="col-lg-3">
                                    <div class="mb-3">
                                        <label for="passwordInput" class="form-label">Contraseña</label>
                                        <input type="password" class="form-control" id="passwordInput" name="UserPassword" placeholder="********" required />
                                        <div class="invalid-feedback">POR FAVOR ESTE CAMPO ES REQUERIDO</div>
                                    </div>
                                </div>

                                <!-- TAXO -->
                                <div class="divider-with-text"><span>Taxo Parameter Settings</span></div>

                                <!-- Establecimiento -->
                                <div class="col-lg-6">
                                    <div class="mb-3">
                                        <label for="establishmentId" class="form-label">Nombre del establecimiento</label>
                                        <select class="form-control" id="establishmentId" name="UserEstablishmentId" required>
                                            @foreach (var establishment in Model.Establishments)
                                            {
                                                <option value="@establishment.EstablishmentId">@establishment.EstablishmentName</option>
                                            }
                                        </select>
                                        <div class="invalid-feedback">POR FAVOR ESTE CAMPO ES REQUERIDO</div>
                                    </div>
                                </div>

                                <!-- Consultorios -->
                                <div class="col-lg-6">
                                    <div class="mb-3">
                                        <label for="medicalOfficesSelect" class="form-label">Seleccione los consultorios médicos</label>
                                        <select class="form-control" id="medicalOfficesSelect" name="SelectedOfficeIds" multiple required>
                                            @foreach (var consultorios in Model.MedicalOfficeListDtos)
                                            {
                                                <option value="@consultorios.MedicalOfficeId">@consultorios.Name -(@consultorios.EstablishmentName)</option>
                                            }
                                        </select>
                                        <div class="invalid-feedback">POR FAVOR SELECCIONE AL MENOS UN CONSULTORIO</div>
                                    </div>
                                </div>

                                <!-- IVA -->
                                <div class="col-lg-3" hidden>
                                    <div class="mb-3">
                                        <label for="vatPercentageId" class="form-label">Seleccione el porcentaje de impuestos</label>
                                        <select class="form-control" id="vatPercentageId" name="UserVatpercentageid" required>
                                            @foreach (var percentage in Model.VatBillings)
                                            {
                                                <option value="@percentage.VatbillingId">@percentage.VatbillingPercentage</option>
                                            }
                                        </select>
                                        <div class="invalid-feedback">POR FAVOR ESTE CAMPO ES REQUERIDO</div>
                                    </div>
                                </div>

                                <!-- TAXO Keys -->
                                <div class="col-lg-4">
                                    <div class="mb-3">
                                        <label for="xkeyInput" class="form-label">X-KEY del usuario en TAXO</label>
                                        <input type="text" class="form-control" id="xkeyInput" name="UserXkeytaxo" placeholder="provided by taxo" required />
                                        <div class="invalid-feedback">POR FAVOR ESTE CAMPO ES REQUERIDO</div>
                                    </div>
                                </div>

                                <div class="col-lg-4">
                                    <div class="mb-3">
                                        <label for="xpassInput" class="form-label">X-PASS del usuario en TAXO</label>
                                        <input type="text" class="form-control" id="xpassInput" name="UserXpasstaxo" placeholder="provided by taxo" required />
                                        <div class="invalid-feedback">POR FAVOR ESTE CAMPO ES REQUERIDO</div>
                                    </div>
                                </div>

                                <!-- Horarios -->
                                <div class="divider-with-text"><span>Settings Office Hours</span></div>

                                <div class="col-lg-4">
                                    <div class="mb-3">
                                        <label for="startHour" class="form-label">Hora de inicio</label>
                                        <input class="form-control" type="time" id="startHour" name="StartTime" required />
                                        <div class="invalid-feedback">POR FAVOR ESTE CAMPO ES REQUERIDO</div>
                                    </div>
                                </div>

                                <div class="col-lg-4">
                                    <div class="mb-3">
                                        <label for="endHour" class="form-label">Hora final</label>
                                        <input class="form-control" type="time" id="endHour" name="EndTime" required />
                                        <div class="invalid-feedback">POR FAVOR ESTE CAMPO ES REQUERIDO</div>
                                    </div>
                                </div>

                                <div class="col-lg-4">
                                    <div class="mb-3">
                                        <label for="appointmentInterval" class="form-label">Intervalo de la cita (minutos)</label>
                                        <input class="form-control" type="number" id="appointmentInterval" name="AppointmentInterval" placeholder="120 in minutes" required />
                                        <div class="invalid-feedback">POR FAVOR ESTE CAMPO ES REQUERIDO</div>
                                    </div>
                                </div>
                                <div class="col-lg-12">
                                    <div class="mb-3">
                                        <label for="workDaysSelect" class="form-label">Días de trabajo</label>
                                        <select class="form-control" id="workDaysSelect" name="WorksDays" multiple required>
                                            <option value="1">Lunes</option>
                                            <option value="2">Martes</option>
                                            <option value="3">Miércoles</option>
                                            <option value="4">Jueves</option>
                                            <option value="5">Viernes</option>
                                            <option value="6">Sábado</option>
                                            <option value="0">Domingo</option>
                                        </select>
                                        <div class="invalid-feedback">POR FAVOR SELECCIONE AL MENOS UN DÍA</div>
                                    </div>
                                </div>
                                <!-- Descripción -->
                                <div class="col-lg-12">
                                    <div class="mb-3">
                                        <label for="description" class="form-label">Descripción del doctor</label>
                                        <textarea class="form-control" id="description" name="UserDescription" rows="3" required></textarea>
                                        <div class="invalid-feedback">POR FAVOR ESTE CAMPO ES REQUERIDO</div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                    <!-- Documentos adicionales -->
                    <div class="divider-with-text"><span>Documentos Adicionales</span></div>

                    <div class="accordion mb-4" id="accordionDocuments">
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingDocs">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseDocs" aria-expanded="false" aria-controls="collapseDocs">
                                    Agregar logotipo/firma para documentos
                                </button>
                            </h2>
                            <div id="collapseDocs" class="accordion-collapse collapse" aria-labelledby="headingDocs" data-bs-parent="#accordionDocuments">
                                <div class="accordion-body row g-3">

                                    <!-- Logo -->
                                    <div class="col-lg-6">
                                        <label for="companyLogo" class="form-label">Logotipo de la empresa</label>
                                        <input type="file" class="form-control" name="CompanyLogo" id="companyLogo" accept="image/*" onchange="previewImage(this, 'previewLogo')" />
                                        <img id="previewLogo" class="mt-2 border rounded" style="max-height:150px; display:none;" />
                                    </div>

                                    <!-- Firma -->
                                    <div class="col-lg-6">
                                        <label for="companySignature" class="form-label">Firma digital</label>
                                        <input type="file" class="form-control" name="CompanySignature" id="companySignature" accept="image/*" onchange="previewImage(this, 'previewSignature')" />
                                        <img id="previewSignature" class="mt-2 border rounded" style="max-height:150px; display:none;" />
                                    </div>

                                    <!-- Sello -->
                                    <div class="col-lg-6">
                                        <label for="companyStamp" class="form-label">Sello de la empresa</label>
                                        <input type="file" class="form-control" name="CompanyStamp" id="companyStamp" accept="image/*" onchange="previewImage(this, 'previewStamp')" />
                                        <img id="previewStamp" class="mt-2 border rounded" style="max-height:150px; display:none;" />
                                    </div>

                                    <!-- Certificado -->
                                    <div class="col-lg-6">
                                        <label for="certificateP12" class="form-label">Archivo de certificado (.p12)</label>
                                        <input type="file" class="form-control" name="CertificateP12" id="certificateP12" accept=".p12" />
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Botones -->
                    <div class="col-lg-12" style="padding-top:3px">
                        <div class="hstack gap-2 justify-content-end">
                            <button type="submit" id="btnCrearUsuario" class="btn btn-primary">
                                <i class="ri-user-add-line"></i> Crear Usuario
                            </button>
                            <a href="@Url.Action("UserList", "Users")" class="btn btn-soft-secondary">
                                <i class="ri-arrow-go-back-line"></i> Cancelar
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </form>
</div>

@section scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js" crossorigin="anonymous"></script>

    <!-- Select2 (no aplicar a estos selects) -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/assets/js/pages/select2.init.js"></script>

    <!-- FilePond -->
    <script src="https://unpkg.com/filepond-plugin-file-validate-type/dist/filepond-plugin-file-validate-type.min.js"></script>
    <script src="https://unpkg.com/filepond-plugin-image-preview/dist/filepond-plugin-image-preview.min.js"></script>
    <script src="https://unpkg.com/filepond/dist/filepond.min.js"></script>

    <!-- Choices -->
    <script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // ===== Inicializar Choices con scoping explícito (evita doble init) =====
            const choicesMap = {};

            const initChoices = (selector, options = {}) => {
                const el = document.querySelector(selector);
                if (!el) return null;
                if (el.dataset.choices === 'active') return null; // evitar doble init
                const inst = new Choices(el, Object.assign({
                    removeItemButton: true,
                    shouldSort: false,
                    placeholder: true
                }, options));
                el.dataset.choices = 'active';
                choicesMap[selector] = inst;
                return inst;
            };
                    initChoices('#workDaysSelect', {
            removeItemButton: true,
            placeholderValue: 'Seleccione los días laborales',
            searchEnabled: false // No es necesario buscar entre 7 días
        });
            // Simples
            initChoices('#profileSelect');
            initChoices('#specialtyId');
            initChoices('#countryId');
            initChoices('#establishmentId');
            initChoices('#vatPercentageId');

            // Múltiple: consultorios
            const officesChoices = initChoices('#medicalOfficesSelect', { removeItemButton: true });

            // ===== Doctores con "Seleccionar todos" =====
            const doctorSelect = document.getElementById('doctorSelect');
            const hiddenDoctorIds = document.getElementById('selectedDoctorIds');

            if (doctorSelect && !doctorSelect.querySelector('option[value="__all__"]')) {
                doctorSelect.insertAdjacentHTML('afterbegin', '<option value="__all__">-- Seleccionar todos --</option>');
            }

            const doctorChoices = initChoices('#doctorSelect', { removeItemButton: true });

            const syncHiddenDoctors = () => {
                const values = doctorChoices ? doctorChoices.getValue(true) : [];
                hiddenDoctorIds.value = values.filter(v => v !== '__all__').join(',');
            };

            if (doctorSelect) {
                doctorSelect.addEventListener('change', () => {
                    const values = doctorChoices.getValue(true);
                    if (values.includes('__all__')) {
                        doctorChoices.removeActiveItemsByValue('__all__');
                        const allValues = Array.from(doctorSelect.options).map(o => o.value).filter(v => v !== '__all__');
                        doctorChoices.setChoiceByValue(allValues);
                    }
                    syncHiddenDoctors();
                });
            }

            // ===== Mostrar/ocultar doctores según perfil =====
            const profileSelect = document.getElementById('profileSelect');
            const doctorContainer = document.getElementById('doctorSelectContainer');

            const clearDoctors = () => {
                if (doctorChoices) {
                    doctorChoices.removeActiveItems();
                    syncHiddenDoctors();
                }
            };

            const toggleDoctorContainer = () => {
                const isAsistente = (profileSelect?.value === '3'); // ajusta si tu "Asistente" tiene otro ID
                doctorContainer.style.display = isAsistente ? 'block' : 'none';
                if (!isAsistente) clearDoctors();
            };

            if (profileSelect && doctorContainer) {
                profileSelect.addEventListener('change', toggleDoctorContainer);
                toggleDoctorContainer(); // estado inicial
            }

            // ===== Preview imágenes =====
            window.previewImage = function (input, previewId) {
                const file = input.files?.[0];
                const preview = document.getElementById(previewId);
                if (!preview) return;
                if (file && file.type.startsWith('image/')) {
                    const reader = new FileReader();
                    reader.onload = e => {
                        preview.src = e.target.result;
                        preview.style.display = 'block';
                    };
                    reader.readAsDataURL(file);
                } else {
                    preview.src = '';
                    preview.style.display = 'none';
                }
            };

            // ===== Bootstrap validation =====
            (() => {
                const forms = document.querySelectorAll('.needs-validation');
                Array.from(forms).forEach(form => {
                    form.addEventListener('submit', (event) => {
                        if (!form.checkValidity()) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        form.classList.add('was-validated');
                    }, false);
                });
            })();

            // Sync inicial de doctores (por si el server precarga algo)
            syncHiddenDoctors();
        });
    </script>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <script>
            Swal.fire({ title: '¡Éxito!', text: '@successMessage', icon: 'success', confirmButtonText: 'OK', timer: 3000 });
        </script>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <script>
            Swal.fire({ title: 'Error', text: '@errorMessage', icon: 'error', confirmButtonText: 'OK', timer: 3000 });
        </script>
    }
}
