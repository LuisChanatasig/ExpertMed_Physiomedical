@model IEnumerable<ExpertMed.Models.PatientDTO>

@{
    ViewBag.Title = "Listado de pacientes";
    ViewBag.pTitle = "Listado de pacientes";
    ViewBag.pageTitle = "Listado de pacientes";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
}
@using Microsoft.AspNetCore.Http
@{
    var perfilId = ViewContext.HttpContext.Session.GetInt32("PerfilId") ?? 0;
    var usuarioId = ViewContext.HttpContext.Session.GetInt32("UsuarioId") ?? 0;
}

@section styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css" />
    <style>
        .patient-avatar {
            width: 32px;
            height: 32px;
            object-fit: cover;
            border-radius: 50%
        }

        .search-container {
            position: relative
        }

        .search-spinner {
            position: absolute;
            right: 45px;
            top: 50%;
            transform: translateY(-50%);
            display: none
        }

        .table-actions {
            width: 120px;
        }
    </style>
}

<div class="row">
    <div class="col-lg-12">
        <div class="card shadow-sm border">
            <div class="card-header bg-light">
                <h5 class="card-title mb-0">
                    <i class="mdi mdi-account-multiple-outline me-2"></i> Listado de pacientes
                </h5>
            </div>

            <div class="card-body">
                <div class="row align-items-end mb-3">
                    <div class="col-md-6 col-lg-4">
                        <a href="@Url.Action("NewPatient", "Patient")" class="btn btn-info">
                            <i class="bx bx-user-plus"></i> Registrar nuevo paciente
                        </a>
                    </div>

                    <div class="col-md-6 col-lg-8">
                        <div class="d-flex justify-content-end align-items-center gap-2">
                            <div class="search-container">
                                <div class="input-group" style="width:320px;">
                                    <span class="input-group-text"><i class="mdi mdi-magnify"></i></span>
                                    <input id="globalSearch" type="search" class="form-control"
                                           placeholder="Buscar por nombre, documento..." autocomplete="off" />
                                    <div class="search-spinner">
                                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                    </div>
                                    <button id="clearSearch" class="btn btn-outline-secondary" type="button"><i class="mdi mdi-close"></i></button>
                                </div>
                                <div id="searchResults" class="mt-1 text-muted small"></div>
                            </div>
                            <div id="exportButtons" class="btn-group"></div>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table id="patientsTable" class="table table-hover table-bordered align-middle w-100">
                        <thead class="table-light">
                            <tr>
                                <th class="d-none">ID</th>
                                <th>Código</th>
                                @if (new[] { 1, 3, 4, 8 }.Contains(perfilId))
                                {
                                    <th>Doctor</th>
                                }
                                <th>Paciente</th>
                                <th>Documento</th>
                                <th>Email</th>
                                <th>Nacionalidad</th>
                                <th class="text-center table-actions">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var patient in Model)
                            {
                                <tr data-patient-id="@patient.PatientId">
                                    <td class="d-none">@patient.PatientId</td>
                                    <td><span class="badge bg-primary-subtle text-primary">@patient.PatientCode</span></td>
                                    @if (new[] { 1, 3, 4, 8 }.Contains(perfilId))
                                    {
                                        <td><span class="fw-medium">@(string.IsNullOrEmpty(patient.DoctorFullname) ? "(Sin asignar)" : patient.DoctorFullname)</span></td>
                                    }
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="~/assets/images/svg/medicUsers.svg" alt="Avatar" class="patient-avatar me-2">
                                            <div>
                                                <div class="fw-medium text-primary">@patient.PatientFirstsurname @patient.PatientSecondlastname</div>
                                                <div class="text-muted small">@patient.PatientFirstname @patient.PatientMiddlename</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="font-monospace">@patient.PatientDocumentNumber</span></td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(patient.PatientEmail))
                                        {
                                            <a href="mailto:@patient.PatientEmail" class="text-decoration-none">@patient.PatientEmail</a>
                                        }
                                    </td>
                                    <td>@patient.NationalityName</td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary btn-actions"
                                                data-bs-toggle="modal" data-bs-target="#actionsModal"
                                                data-id="@patient.PatientId"
                                                data-code="@patient.PatientCode"
                                                data-name="@($"{patient.PatientFirstname} {patient.PatientFirstsurname}")"
                                                data-status="@patient.PatientStatus"
                                                data-doctor-id="@(patient.DoctorUserId ?? 0)"
                                                data-doctor-name="@patient.DoctorFullname">
                                            <i class="ri-settings-3-line"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="actionsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="mdi mdi-account-cog me-2"></i>Acciones para Paciente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info">
                    <div class="d-flex align-items-center">
                        <i class="mdi mdi-information-outline me-2 fs-4"></i>
                        <div>
                            <strong id="m-name"></strong><br>
                            <small class="text-muted">Código: <span id="m-code"></span></small><br>
                            <small class="text-muted" id="m-doctor-info">Médico: <span id="m-doctor-name"></span></small>
                        </div>
                    </div>
                </div>

                <div id="assignDoctorCta" class="mb-3 d-none">
                    <div class="alert alert-warning d-flex align-items-start">
                        <i class="mdi mdi-account-alert-outline me-2 fs-4"></i>
                        <div>
                            <div class="fw-semibold">Este paciente no tiene un médico asignado.</div>
                            <div class="small text-muted mb-2">Debes asignarlo para habilitar todas las funciones.</div>
                            <a id="goEditPatient" class="btn btn-sm btn-primary">Asignar médico ahora</a>
                        </div>
                    </div>
                </div>

                <div id="actionButtons" class="d-grid gap-2"></div>
                <div id="statusTimeline" class="mt-4"></div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        const PERFIL_ID = @perfilId;
        const USUARIO_ID = @usuarioId;

        $(function () {
            'use strict';

            // Búsqueda sin acentos (Normalización)
            $.fn.dataTable.ext.type.search.string = function (data) {
                return !data ? '' : data.toString().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
            };

            const table = $('#patientsTable').DataTable({
                language: { url: 'https://cdn.datatables.net/plug-ins/1.13.8/i18n/es-ES.json' },
                responsive: true,
                stateSave: true,
                pageLength: 25,
                dom: 'Blrtip',
                buttons: [
                    { extend: 'excelHtml5', text: '<i class="mdi mdi-file-excel"></i> Excel', className: 'btn btn-sm btn-success', exportOptions: { columns: ':visible:not(.table-actions)' } },
                    { extend: 'pdfHtml5', text: '<i class="mdi mdi-file-pdf"></i> PDF', className: 'btn btn-sm btn-danger', orientation: 'landscape', exportOptions: { columns: ':visible:not(.table-actions)' } }
                ]
            });
            table.buttons().container().appendTo('#exportButtons');

            // Búsqueda con Spinner y Debounce
            const $spinner = $('.search-spinner');
            const debouncedSearch = (function(fn, ms) {
                let t; return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); };
            })((term) => {
                const norm = term.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
                table.search(norm).draw();
                $spinner.hide();
            }, 300);

            $('#globalSearch').on('input', function() {
                $spinner.show();
                debouncedSearch(this.value);
            });

            $('#clearSearch').on('click', function() {
                $('#globalSearch').val('').focus();
                table.search('').draw();
            });

            table.on('draw.dt', function() {
                const info = table.page.info();
                $('#searchResults').text(info.recordsDisplay === info.recordsTotal ? '' : `${info.recordsDisplay} encontrados`);
            });

            // Lógica del Modal
            $('#actionsModal').on('show.bs.modal', function (event) {
                const b = $(event.relatedTarget);
                const p = {
                    id: b.data('id'),
                    code: b.data('code'),
                    name: b.data('name'),
                    status: Number(b.data('status')),
                    docId: Number(b.data('doctor-id')) || 0,
                    docName: b.data('doctor-name') || '(Sin asignar)'
                };

                // Lógica de Médico: ¿Tiene médico asignado?
                const isAssigned = p.docId > 0;
                // Si el logueado es médico, él es el responsable si no hay uno fijo
                let responsibleDocId = isAssigned ? p.docId : (PERFIL_ID === 2 ? USUARIO_ID : 0);

                $('#m-name').text(p.name);
                $('#m-code').text(p.code);
                $('#m-doctor-name').text(p.docName);

                const editUrl = `@Url.Action("UpdatePatient", "Patient")?id=${p.id}&returnUrl=${encodeURIComponent(window.location.pathname)}`;
                $('#goEditPatient').attr('href', editUrl);
                $('#assignDoctorCta').toggleClass('d-none', isAssigned);

                const $btns = $('#actionButtons').empty();
                if (p.status === 1) {
                    const emergencyBtn = responsibleDocId > 0
                        ? `<button class="btn btn-danger" onclick="createEmergency(${p.id}, ${responsibleDocId})"><i class="ri-alert-line me-2"></i>Cita de Emergencia</button>`
                        : `<button class="btn btn-danger" disabled title="Asigna un médico para esta acción"><i class="ri-alert-line me-2"></i>Cita de Emergencia</button>`;

                    $btns.append(`
                        ${emergencyBtn}
                        <a href="${editUrl}" class="btn btn-info"><i class="ri-edit-line me-2"></i>Modificar o Agendar</a>
                        <button class="btn btn-warning" onclick="changeStatus(${p.id}, 0)"><i class="ri-pause-circle-line me-2"></i>Desactivar Paciente</button>
                    `);
                } else {
                    $btns.append(`
                        <button class="btn btn-success" onclick="changeStatus(${p.id}, 1)"><i class="ri-play-circle-line me-2"></i>Activar Paciente</button>
                        <a href="${editUrl}" class="btn btn-info"><i class="ri-edit-line me-2"></i>Modificar Datos</a>
                    `);
                }

                $('#statusTimeline').html(p.status === 1
                    ? `<div class="alert alert-success small"><i class="mdi mdi-check-circle me-2"></i>Paciente Activo: Puede recibir atención.</div>`
                    : `<div class="alert alert-secondary small"><i class="mdi mdi-pause-circle me-2"></i>Paciente Inactivo.</div>`
                );
            });

            // Funciones Globales
            window.changeStatus = function(id, st) {
                Swal.fire({
                    title: '¿Confirmar cambio de estado?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, cambiar',
                    cancelButtonText: 'Cancelar'
                }).then(r => {
                    if (!r.isConfirmed) return;
                    const f = document.createElement('form');
                    f.method = 'POST';
                    f.action = '@Url.Action("ChangePatientStatus", "Patient")';
                    f.innerHTML = `<input type="hidden" name="patientId" value="${id}"><input type="hidden" name="status" value="${st}">`;
                    document.body.appendChild(f); f.submit();
                });
            };

            window.createEmergency = function(pid, did) {
                Swal.fire({
                    title: '¿Crear cita de emergencia?',
                    text: 'Se agendará una atención inmediata.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'Sí, crear'
                }).then(r => {
                    if (!r.isConfirmed) return;
                    const now = new Date();
                    fetch(`@Url.Action("CreateAppointment", "Appointment")?doctorUserId=${did}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            appointmentDate: now.toISOString().split('T')[0],
                            appointmentHour: now.toTimeString().substring(0, 5),
                            appointmentPatientid: pid,
                            appointmentStatus: 5
                        })
                    }).then(res => res.json()).then(data => {
                        if (data.success) {
                            Swal.fire('¡Éxito!', 'Cita creada.', 'success').then(() => location.reload());
                            if (data.whatsappUrl) window.open(data.whatsappUrl, '_blank');
                        } else {
                            Swal.fire('Error', data.message || 'No se pudo crear', 'error');
                        }
                    });
                });
            };

            // Notificaciones TempData
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <text>Swal.fire({ title: '¡Éxito!', text: '@Html.Raw(successMessage)', icon: 'success', timer: 3000, showConfirmButton: false });</text>
            }
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <text>Swal.fire({ title: 'Error', text: '@Html.Raw(errorMessage)', icon: 'error' });</text>
            }
        });
    </script>
}