@using Microsoft.AspNetCore.Http
@{
    ViewBag.Title = "Crear Paciente";
    ViewBag.pTitle = "Pacientes";
    ViewBag.pageTitle = "Crear Paciente";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;

    var usuarioId = ViewContext.HttpContext.Session.GetInt32("UsuarioId");
    var perfilId = ViewContext.HttpContext.Session.GetInt32("PerfilId");
}
@model NewPatientViewModel

<div class="position-relative mx-n4 mt-n4">
    <div class="profile-wid-bg profile-setting-img">
        <img src="~/assets/images/auth-one-bg.jpg" class="profile-wid-img" alt="">
        <div class="overlay-content">
            <div class="text-end p-3">
                <div class="p-0 ms-auto rounded-circle profile-photo-edit">
                    <h1 class="cabeceras"> <i class="ri-survey-fill"></i> Registrar un nuevo paciente</h1>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <form asp-action="NewPatient" asp-controller="Patient" method="POST" class="row g-3 needs-validation" novalidate>
        @* Auditoría *@
        <input type="hidden" name="PatientCreationuser" value="@usuarioId" />
        <input type="hidden" name="PatientModificationuser" value="@usuarioId" />
        <input type="hidden" name="PatientStatus" value="1" />

        <div class="col-xxl-12">
            <div class="card mt-xxl-n5">
                <div class="card-body p-4">
                    <div class="tab-content">
                        <h6 class="text-danger">Campos obligatorios *</h6>

                        <div class="tab-pane active" id="personalDetails" role="tabpanel">
                            <div class="row">
                                <div class="divider-with-text mb-4">
                                    <i class="ri-user-fill" id="icons"></i> <span> Datos Personales </span>
                                </div>

                                @* Selección de Médico *@
                                @if (perfilId == 1 || perfilId == 3 || perfilId == 4 || perfilId == 8)
                                {
                                    <div class="col-lg-12 mb-3">
                                        <label for="doctorsSelect" class="form-label">Médico Asignado</label>
                                        <select class="form-control" id="doctorsSelect" name="doctorUserId" data-choices>
                                            <option value="">Seleccione un médico</option>
                                            @foreach (var doctor in Model.Users)
                                            {
                                                <option value="@doctor.UsersId">@doctor.UsersSurcenames @doctor.UsersNames - @doctor.SpecialityName</option>
                                            }
                                        </select>
                                    </div>
                                }

                                <div class="col-lg-3 mb-3">
                                    <label class="form-label">Primer Apellido *</label>
                                    <input type="text" class="form-control" name="PatientFirstsurname" placeholder="Primer Apellido" required>
                                    <div class="invalid-feedback">Requerido</div>
                                </div>

                                <div class="col-lg-3 mb-3">
                                    <label class="form-label">Segundo Apellido</label>
                                    <input type="text" class="form-control" name="PatientSecondlastname" placeholder="Segundo Apellido">
                                </div>

                                <div class="col-lg-3 mb-3">
                                    <label class="form-label">Primer Nombre *</label>
                                    <input type="text" class="form-control" name="PatientFirstname" placeholder="Primer Nombre" required>
                                    <div class="invalid-feedback">Requerido</div>
                                </div>

                                <div class="col-lg-3 mb-3">
                                    <label class="form-label">Segundo Nombre</label>
                                    <input type="text" class="form-control" name="PatientMiddlename" placeholder="Segundo Nombre">
                                </div>

                                <div class="col-lg-3 mb-3">
                                    <label class="form-label">Tipo Documento *</label>
                                    <select class="form-control" name="PatientDocumenttype" data-choices required>
                                        @foreach (var doc in Model.DocumentTypes)
                                        {
                                            <option value="@doc.CatalogId">@doc.CatalogName</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-lg-3 mb-3">
                                    <label class="form-label">Número Documento *</label>
                                    <input type="text" class="form-control" name="PatientDocumentnumber" placeholder="Ej: 1700000000" required>
                                    <div class="invalid-feedback">Requerido</div>
                                </div>

                                <div class="col-lg-3 mb-3">
                                    <label class="form-label">Fecha Nacimiento *</label>
                                    <input type="date" class="form-control" id="birthdate" name="PatientBirthdate" required>
                                    <div class="invalid-feedback">Requerido</div>
                                </div>

                                <div class="col-lg-1 mb-3">
                                    <label class="form-label">Edad</label>
                                    <input type="number" class="form-control" id="agePatient" name="PatientAge" readonly>
                                </div>

                                <div class="col-lg-2 mb-3">
                                    <label class="form-label">Género</label>
                                    <select class="form-control" name="PatientGender" data-choices>
                                        @foreach (var g in Model.GenderTypes)
                                        {
                                            <option value="@g.CatalogId">@g.CatalogName</option>
                                        }
                                    </select>
                                </div>

                                <div class="divider-with-text my-4">
                                    <i class="ri-contacts-book-2-fill" id="icons"></i> <span> Información de Contacto y Adicional </span>
                                </div>

                                <div class="col-lg-4 mb-3">
                                    <label class="form-label">Email *</label>
                                    <input type="email" class="form-control" name="PatientEmail" placeholder="paciente@correo.com" required>
                                    <div class="invalid-feedback">Email válido requerido</div>
                                </div>

                                <div class="col-lg-4 mb-3">
                                    <label class="form-label">Celular *</label>
                                    <input type="text" class="form-control" name="PatientCellularPhone" placeholder="0900000000" required>
                                    <div class="invalid-feedback">Requerido</div>
                                </div>

                                <div class="col-lg-4 mb-3">
                                    <label class="form-label">Teléfono Fijo</label>
                                    <input type="text" class="form-control" name="PatientLandlinePhone" placeholder="02-000-000">
                                </div>

                                <div class="col-lg-12 mb-3">
                                    <label class="form-label">Dirección Completa *</label>
                                    <textarea class="form-control" name="PatientAddress" rows="2" placeholder="Calle principal, secundaria y número de casa" required></textarea>
                                    <div class="invalid-feedback">Requerido</div>
                                </div>

                                <div class="col-lg-4 mb-3">
                                    <label class="form-label">Nacionalidad</label>
                                    <select class="form-control" name="PatientNationality" data-choices>
                                        @foreach (var n in Model.Countries)
                                        {
                                            <option value="@n.CountryId">@n.CountryNationality</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-lg-4 mb-3">
                                    <label class="form-label">Provincia/Ciudad</label>
                                    <select class="form-control" name="PatientProvince" data-choices>
                                        @foreach (var p in Model.Provinces)
                                        {
                                            <option value="@p.ProvinceId">@p.ProvinceName</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-lg-4 mb-3">
                                    <label class="form-label">Ocupación</label>
                                    <input type="text" class="form-control" name="PatientOcupation" placeholder="Ej: Ingeniero">
                                    <input type="hidden" class="form-control" name="PatientCode" placeholder="Ej: Ingeniero">
                                </div>

                            </div>
                        </div>
                    </div>

                    <div class="hstack gap-2 justify-content-end mt-4">
                        <button type="submit" class="btn btn-primary btn-label">
                            <i class="ri-user-add-line label-icon align-middle fs-16 me-2"></i> Registrar Paciente
                        </button>
                        <a href="@Url.Action("PatientList", "Patient")" class="btn btn-light">
                            Cancelar
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/assets/libs/choices.js/public/assets/scripts/choices.min.js"></script>

    <script>
        // Cálculo de Edad Dinámico
        document.getElementById('birthdate').addEventListener('change', function () {
            const birthDate = new Date(this.value);
            if (isNaN(birthDate)) return;

            const today = new Date();
            let age = today.getFullYear() - birthDate.getFullYear();
            const month = today.getMonth() - birthDate.getMonth();

            if (month < 0 || (month === 0 && today.getDate() < birthDate.getDate())) {
                age--;
            }
            document.getElementById('agePatient').value = age >= 0 ? age : 0;
        });

        // Validación de Bootstrap
        (function () {
            'use strict'
            var forms = document.querySelectorAll('.needs-validation')
            Array.prototype.slice.call(forms).forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    }
                    form.classList.add('was-validated')
                }, false)
            })
        })()

        // Notificaciones SweetAlert
        @if (!string.IsNullOrEmpty(successMessage))
        {
                <text>
                Swal.fire({
                    title: '¡Completado!',
                    text: '@successMessage',
                    icon: 'success',
                    confirmButtonClass: 'btn btn-primary w-xs mt-2',
                    buttonsStyling: false
                }).then(() => {
                    window.location.href = '@Url.Action("PatientList", "Patient")';
                });
                </text>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
                <text>
                Swal.fire({
                    title: 'Error',
                    text: '@errorMessage',
                    icon: 'error',
                    confirmButtonClass: 'btn btn-danger w-xs mt-2',
                    buttonsStyling: false
                });
                </text>
        }
    </script>
}