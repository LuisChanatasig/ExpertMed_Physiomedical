@using Microsoft.AspNetCore.Http
@using System.Text.Json
@{
    ViewBag.Title = "Home";
    ViewBag.pTitle = "Home";
    ViewBag.pageTitle = "Dashboards";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var perfilId = ViewContext.HttpContext.Session.GetInt32("PerfilId") ?? 0;
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;

    string mensajeBot = perfilId switch
    {
        1 => "Hola administrador, ¿qué área quieres revisar hoy?",
        3 => "¡Listo para ayudarte a gestionar pacientes y citas!",
        4 => "Administra tu clínica con eficiencia. ¿Comenzamos?",
        5 => "¿Listo para registrar nuevos resultados de laboratorio?",
        6 => "Puedes consultar o subir estudios de imagen ahora mismo.",
        2 => "Bienvenido doctor, tienes acceso a tus pacientes y consultas.",
        _ => "Pronto me tendrás como tu asistente inteligente!"
    };

    var acciones = new List<(string Texto, string Icono, string Ctrl, string Accion, string Clase)>();
    void Add(string t, string ic, string c, string a, string clase) => acciones.Add((t, ic, c, a, clase));

    switch (perfilId)
    {
        case 3:
            Add("VER TODAS MIS CITAS", "ri-file-search-line", "Appointment", "AppointmentList", "btn-primary");
            Add("REGISTRAR PACIENTE", "ri-user-add-line", "Patient", "Create", "btn-secondary");
            break;
        case 5:
            Add("SOLICITUDES DE LABORATORIO", "mdi mdi-flask-outline", "Laboratorio", "LaboratoryList", "btn-primary");
            Add("REGISTRAR RESULTADOS", "mdi mdi-pencil-box-outline", "Laboratorio", "RegistrarResultado", "btn-secondary");
            break;
        case 6:
            Add("SOLICITUDES DE IMÁGENES", "mdi mdi-image-multiple-outline", "Imagenes", "ListaImagenes", "btn-primary");
            Add("REGISTRAR RESULTADOS", "mdi mdi-pencil-box-outline", "Imagenes", "RegistrarResultadoImagen", "btn-secondary");
            break;
        case 1:
        case 4:
            Add("CITAS", "ri-file-search-line", "Appointment", "AppointmentList", "btn-primary");
            Add("CONSULTAS MÉDICAS", "ri-newspaper-line", "Consultation", "NewConsultation", "btn-secondary");
            Add("VER REPORTES", "mdi mdi-chart-bar", "ReportesConsultas", "ResumenConsultas", "btn-outline-success");
            break;
        default:
            Add("CITAS", "ri-file-search-line", "Appointment", "AppointmentList", "btn-primary");
            Add("CONSULTAS", "ri-newspaper-line", "Consultation", "ConsultationList", "btn-secondary");
            break;
    }

    // Pasos del tour de esta pantalla
    var steps = new[]
    {
        new { selector = "#heroContent",    html = "<div class='mb-2 fw-bold'>📋 Panel principal</div><div>Información y accesos rápidos, pensado para móviles.</div>", position = "bottom" },
        new { selector = "#accionesWrap",   html = "<div class='mb-2 fw-bold'>🎯 Acciones por perfil</div><div>Los accesos se adaptan a tu rol actual.</div>", position = "bottom" },
        new { selector = "#expertbotGuide", html = "<div class='mb-2 fw-bold'>🤖 ExpertBot</div><div>Haz clic para chatear, usar <code>/tour</code> o pedir ayuda contextual.</div>", position = "left" }
    };

    var funciones = acciones.Select(a => a.Texto).ToList();

    string perfilTexto = perfilId switch
    {
        1 => "Administrador: control total sobre el sistema, usuarios, consultorios, citas, consultas y reportes.",
        2 => "Doctor: accede a tus pacientes y consultas.",
        3 => "Recepción: gestiona citas y registra pacientes.",
        4 => "Gestión: citas, consultas y reportes de la clínica.",
        5 => "Lab: solicitudes y registro de resultados.",
        6 => "Imágenes: estudios e informes radiológicos.",
        _ => "Perfil no identificado."
    };

    // Serializa para JS (todo crudo con Html.Raw)
    var stepsJs = JsonSerializer.Serialize(steps);
    var funcionesJs = JsonSerializer.Serialize(funciones);
    var mensajeBotJs = JsonSerializer.Serialize(mensajeBot);
    var perfilTextoJs = JsonSerializer.Serialize(perfilTexto);
}

@section styles {
    <!-- Define valores que el Layout leerá ANTES de inicializar el bot -->
    <script>
        window.EBG_STEPS = @Html.Raw(stepsJs);
        window.EBG_FUNCS = @Html.Raw(funcionesJs);

        // Overrides opcionales por pantalla:
        window.EBG_OPTIONS = { greetMessage: @Html.Raw(mensajeBotJs) };
    </script>

    <style>
        #accionesWrap a.btn {
            border-radius: 999px;
        }
    </style>
}

<div class="row">
    <div class="col-12">
        <div class="card hero-card border-0 shadow-sm rounded-3 overflow-hidden" id="heroCard">
            <div class="card-body bg-marketplace d-flex align-items-center gap-3">
                <div class="flex-grow-1" id="heroContent">
                    <div class="d-flex align-items-center justify-content-between gap-2">
                        <div>
                            <h1 class="fs-18 lh-base mb-1">
                                Otras opciones <br /> para <span class="text-success">ti.</span>
                            </h1>
                            <p class="mb-0 mt-2 pt-1 text-muted">¿Qué deseas hacer hoy?</p>
                        </div>
                    </div>

                    <div class="acciones d-flex flex-wrap gap-2 gap-sm-3 mt-3" id="accionesWrap">
                        @foreach (var a in acciones)
                        {
                            var url = Url.Action(a.Accion, a.Ctrl);
                            <a href="@url" class="btn @a.Clase">
                                <i class="@a.Icono"></i>
                                <span class="ms-1">@a.Texto</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    @* No re-inicialices el bot aquí. El Layout ya lo hace. *@

    @if (!string.IsNullOrEmpty(successMessage))
    {
        var successJs = JsonSerializer.Serialize(successMessage);
        <script>
            Swal.fire({ title: '¡Éxito!', text: @Html.Raw(successJs), icon: 'success', timer: 3000, confirmButtonText: 'OK' });
        </script>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        var errorJs = JsonSerializer.Serialize(errorMessage);
        <script>
            Swal.fire({ title: 'Error', text: @Html.Raw(errorJs), icon: 'error', confirmButtonText: 'OK' });
        </script>
    }
}
