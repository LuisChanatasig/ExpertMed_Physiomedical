@using Microsoft.AspNetCore.Http
@using System.Text.Json
@{
    ViewBag.Title = "Home";
    ViewBag.pTitle = "Home";
    ViewBag.pageTitle = "Dashboards";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var perfilId = ViewContext.HttpContext.Session.GetInt32("PerfilId") ?? 0;
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;



    var acciones = new List<(string Texto, string Icono, string Ctrl, string Accion, string Clase)>();
    void Add(string t, string ic, string c, string a, string clase) => acciones.Add((t, ic, c, a, clase));

    switch (perfilId)
    {
        case 4: // Administrativo
            Add("CITAS", "ri-calendar-line", "Appointment", "AppointmentList", "btn-primary");
            Add("PLANIFICACIÓN DE FISIOTERAPIA", "mdi mdi-calendar-clock", "Fisioterapia", "TherapySchedule", "btn-secondary");
            Add("HISTORIAL DE TERAPIAS", "mdi mdi-history", "Fisioterapia", "TherapyHistory", "btn-outline-success");
            break;

        case 7: // Fisioterapeuta
            Add("PLANIFICACIÓN DE FISIOTERAPIA", "mdi mdi-calendar-clock", "Fisioterapia", "TherapySchedule", "btn-primary");
            Add("HISTORIAL DE TERAPIAS", "mdi mdi-history", "Fisioterapia", "TherapyHistory", "btn-secondary");
            break;

        default:
            Add("PLANIFICACIÓN DE FISIOTERAPIA", "mdi mdi-calendar-clock", "Fisioterapia", "TherapySchedule", "btn-primary");
            break;
    }
 



}

@section styles {
 

    <style>
        #accionesWrap a.btn {
            border-radius: 999px;
        }
    </style>
}

<div class="row">
    <div class="col-12">
        <div class="card hero-card border-0 shadow-sm rounded-3 overflow-hidden" id="heroCard">
            <div class="card-body bg-marketplace d-flex align-items-center gap-3">
                <div class="flex-grow-1" id="heroContent">
                    <div class="d-flex align-items-center justify-content-between gap-2">
                        <div>
                            <h1 class="fs-18 lh-base mb-1">
                                Otras opciones <br /> para <span class="text-success">ti.</span>
                            </h1>
                            <p class="mb-0 mt-2 pt-1 text-muted">¿Qué deseas hacer hoy?</p>
                        </div>
                    </div>

                    <div class="acciones d-flex flex-wrap gap-2 gap-sm-3 mt-3" id="accionesWrap">
                        @foreach (var a in acciones)
                        {
                            var url = Url.Action(a.Accion, a.Ctrl);
                            <a href="@url" class="btn @a.Clase">
                                <i class="@a.Icono"></i>
                                <span class="ms-1">@a.Texto</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    @if (!string.IsNullOrEmpty(successMessage))
    {
        var successJs = JsonSerializer.Serialize(successMessage);
        <script>
            Swal.fire({ title: '¡Éxito!', text: @Html.Raw(successJs), icon: 'success', timer: 3000, confirmButtonText: 'OK' });
        </script>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        var errorJs = JsonSerializer.Serialize(errorMessage);
        <script>
            Swal.fire({ title: 'Error', text: @Html.Raw(errorJs), icon: 'error', confirmButtonText: 'OK' });
        </script>
    }
}
