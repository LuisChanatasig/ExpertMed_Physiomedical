@using Microsoft.AspNetCore.Http
@using System.Text.Json
@{
    // -------------------------------------------------------------------------
    // 1. RECUPERACIÓN DE SESIÓN Y DATOS DE USUARIO
    // -------------------------------------------------------------------------
    var usuarioId = ViewContext.HttpContext.Session.GetInt32("UsuarioId");
    var perfilId = ViewContext.HttpContext.Session.GetInt32("PerfilId").GetValueOrDefault(0);
    var usuarioNombre = ViewContext.HttpContext.Session.GetString("UsuarioNombre");
    var usuarioApellido = ViewContext.HttpContext.Session.GetString("UsuarioApellido");
    var establecimientoId = ViewContext.HttpContext.Session.GetInt32("UsuarioEstablecimientoId");
    var usuarioEspecialidad = ViewContext.HttpContext.Session.GetString("UsuarioEspecialidad");

    // Foto de perfil
    var fotoPerfilBase64 = ViewContext.HttpContext.Session.GetString("UsuarioFotoPerfil");
    var rutaImagenPorDefecto = Url.Content("~/assets/images/users/multi-user.jpg");
    string fotoPerfilSrc = string.IsNullOrEmpty(fotoPerfilBase64)
        ? rutaImagenPorDefecto
        : $"data:image/jpeg;base64,{fotoPerfilBase64}";

    // -------------------------------------------------------------------------
    // 2. LÓGICA DE PERMISOS (MATRIZ DE ACCESO) - PERFIL 4 (GESTIÓN + FISIO)
    // -------------------------------------------------------------------------
    bool isSuperAdmin = (perfilId == 1);
    bool isGestion = (perfilId == 4);

    // Módulos Administrativos
    bool showAdminSection = (isSuperAdmin || isGestion);
    bool showConsultorios = (isSuperAdmin || isGestion);
    bool showEstablishment = (isSuperAdmin || isGestion);
    bool showUsers = (isSuperAdmin || isGestion);
    bool showCatalogos = isSuperAdmin;

    // Módulos Operativos / Clínicos / Servicios
    bool showPacientes = (isSuperAdmin || isGestion || perfilId == 2 || perfilId == 8);
    bool showAgenda = (isSuperAdmin || isGestion || perfilId == 2 || perfilId == 3 || perfilId == 8 || perfilId == 7);
    bool showFacturacion = (isSuperAdmin || isGestion || perfilId == 8);

    // FISIOTERAPIA: Ahora habilitado para el Perfil 4
    bool showFisio = (isSuperAdmin || isGestion || perfilId == 2 || perfilId == 7);

    // Módulos RESTRINGIDOS para Perfil 4 (Solo Admin y especialistas)
    bool showConsultas = isSuperAdmin || perfilId == 2;
    bool showLab = isSuperAdmin || perfilId == 2 || perfilId == 6;
    bool showImagenes = isSuperAdmin || perfilId == 2 || perfilId == 5;

    // Módulo de Reportes
    bool showReportesGeneral = isSuperAdmin;
}

