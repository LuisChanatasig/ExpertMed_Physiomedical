@using Microsoft.AspNetCore.Http
@using System.Text.Json
@{
    // ===== Serializa datos de sesión a JSON (seguros para JS) =====
    var pageKeyRaw = $"{ViewContext.RouteData.Values["controller"]}.{ViewContext.RouteData.Values["action"]}";
    var usuarioNombreRaw = ViewContext.HttpContext.Session.GetString("UsuarioNombre") ?? "";
    var usuarioPerfilRaw = ViewContext.HttpContext.Session.GetString("UsuarioPerfil") ?? "Perfil no identificado";
    var usuarioEstabRaw = ViewContext.HttpContext.Session.GetString("UsuarioEstablecimiento") ?? "";

    var pageKeyJs = JsonSerializer.Serialize(pageKeyRaw);
    var usuarioNombreJs = JsonSerializer.Serialize(usuarioNombreRaw);
    var usuarioPerfilJs = JsonSerializer.Serialize(usuarioPerfilRaw);
    var usuarioEstabJs = JsonSerializer.Serialize(usuarioEstabRaw);
}
<!doctype html>
<html lang="es" data-layout="vertical" data-topbar="light" data-sidebar="light" data-sidebar-size="lg" data-sidebar-image="none" data-preloader="disable">
<head>
    @await Html.PartialAsync("_title_meta")
    @RenderSection("styles", required: false)
    @await Html.PartialAsync("_head_css")

    <!-- Intro.js CSS -->
    <link rel="stylesheet" href="https://unpkg.com/intro.js/minified/introjs.min.css" />
</head>
<body>
    <div id="layout-wrapper">
        @await Html.PartialAsync("_menu")

        <div class="main-content">
            <div class="page-content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </div>
            @await Html.PartialAsync("_footer")
        </div>
    </div>

    @await Html.PartialAsync("_vendor_scripts")

    <!-- Intro.js JS -->
    <script src="https://unpkg.com/intro.js/minified/intro.min.js"></script>

    @RenderSection("scripts", required: false)

    <script>
        // Temporizador de inactividad
        var timeout = 30 * 60 * 1000; // 30 min
        var logoutTimer = setTimeout(logout, timeout);
        function logout(){ window.location.href = "@Url.Action("SignIn", "Authentication")"; }
        function resetTimer(){ clearTimeout(logoutTimer); logoutTimer = setTimeout(logout, timeout); }
        document.addEventListener("mousemove", resetTimer);
        document.addEventListener("keydown", resetTimer);
    </script>
</body>
</html>
