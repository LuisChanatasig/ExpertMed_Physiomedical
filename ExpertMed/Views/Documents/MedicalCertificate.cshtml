@model NewPatientViewModel
@using System.Globalization
@{
    Layout = null;

    var consulta = Model.Consultation;
    var paciente = Model.DetailsPatient;
    var doctor = $"{consulta.UsersNames} {consulta.UsersSurcenames}";
    var fechaInicial = consulta.ConsultationCreationdate ?? DateTime.Today;
    var diasReposo = consulta.ConsultationDisablilitydays ?? 1;
    var fechaFinal = fechaInicial.AddDays(diasReposo);

    var diaTexto = fechaInicial.ToString("dddd dd", new CultureInfo("es-ES")).ToUpper();
    var mesTexto = fechaInicial.ToString("MMMM", new CultureInfo("es-ES")).ToUpper();
    var anioTexto = fechaInicial.ToString("yyyy");
    var fechaLiteral = $"{diaTexto} DE {mesTexto} DE {anioTexto}";
    var fechaFinalTexto = fechaFinal.ToString("dddd dd 'de' MMMM 'de' yyyy", new CultureInfo("es-ES"));

    var diagnostico = consulta.DiagnosisConsultations?
        .FirstOrDefault(d => d.DiagnosisDefinitive.HasValue && d.DiagnosisDefinitive.Value) ??
        consulta.DiagnosisConsultations?
        .FirstOrDefault(d => d.DiagnosisPresumptive.HasValue && d.DiagnosisPresumptive.Value);

    var diagnosticoNombre = Model.Diagnoses
        .FirstOrDefault(d => d.DiagnosisId == diagnostico?.DiagnosisDiagnosisid)?.DiagnosisName ?? "N/A";

    

}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Certificado Médico</title>
    <style>
        body {
            font-family: Arial;
            margin: 40px;
            font-size: 14px;
        }

        h2 {
            text-align: center;
            font-size: 22px;
            margin-bottom: 20px;
        }

        .section {
            margin-bottom: 20px;
        }

        .section-title {
            font-weight: bold;
            text-decoration: underline;
            margin-bottom: 10px;
        }

        .datos label {
            font-weight: bold;
            display: block;
            margin-top: 5px;
        }

        .footer {
            margin-top: 40px;
            text-align: center;
            font-size: 12px;
            color: #555;
        }

        .signature {
            text-align: center;
            margin-top: 50px;
        }
    </style>
</head>
<body>

    <h2>CERTIFICADO MÉDICO</h2>

    <div class="section">
        <p><strong>Fecha de Emisión:</strong> Quito, @fechaInicial:dd/MM/yyyy</p>
        <p>
            Certifico que el paciente
            <strong>@paciente.PatientFirstname @paciente.PatientMiddlename @paciente.PatientFirstsurname @paciente.PatientSecondlastname</strong>
            con identificación: <strong>@paciente.PatientDocumentnumber</strong> fue atendido el día de hoy <strong>@fechaLiteral</strong>.
        </p>
    </div>

    <div class="section datos">
        <div class="section-title">DATOS DEL PACIENTE</div>
        <label>Nombres y Apellidos:</label> @paciente.PatientFirstname @paciente.PatientMiddlename @paciente.PatientFirstsurname @paciente.PatientSecondlastname
        <label>Dirección:</label> @paciente.PatientAddress
        <label>Teléfono:</label> @paciente.PatientCellularPhone
        <label>Empresa:</label> @paciente.PatientCompany
        <label>Ocupación:</label> @paciente.PatientOcupation
        <label>N° Historia Clínica:</label> @paciente.PatientId
    </div>

    <div class="section">
        <div class="section-title">MOTIVO MÉDICO</div>
        <p><strong>Diagnóstico:</strong> @diagnosticoNombre</p>
        <p>Síntomas: <strong>( X ) Sí</strong> <strong>( ) No</strong></p>
        <p>Enfermedad: <strong>( X ) Sí</strong> <strong>( ) No</strong> — Fiebre, malestar general, otros síntomas relacionados.</p>
        <p>Contingencia: <strong>Enfermedad general</strong></p>
    </div>

    <div class="section">
        <div class="section-title">REPOSO MÉDICO</div>
        <p>Se recomienda reposo médico domiciliario por <strong>@diasReposo</strong> día(s).</p>
        <p><strong>Desde:</strong> @fechaInicial:dd/MM/yyyy - @fechaLiteral</p>
        <p><strong>Hasta:</strong> @fechaFinal:dd/MM/yyyy - @fechaFinalTexto.ToUpper()</p>
    </div>

    <div class="signature">
        <p>ATENTAMENTE,</p>
        <br /><br /><br /><br />
        <p>
            <strong>Dr(a). @doctor</strong><br />
            @consulta.SpecialityName<br />
            Email: @consulta.UsersEmail
        </p>
    </div>

    <div class="footer">
        @if (consulta != null)
        {
            <text>
                <strong>@consulta.EstablishmentName</strong><br />
                @consulta.UsersEstablishmentAddress<br />
                Email: @consulta.UsersEmail
            </text>
        }
        else
        {
            <text>
                CONSULTORIOS INTEGRALES EL BATÁN<br />
                Av. Tomás de Berlanga N43-14 y Av. 6 de Diciembre<br />
                Teléfono: +593 2 2445008 / +593 98 053 5862<br />
                Email: info@consultorioselbatan.com
            </text>
        }
    </div>

</body>
</html>
